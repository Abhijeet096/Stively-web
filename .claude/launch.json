{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "dev-verify",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3002"],
      "port": 3002
    }
  ]
}
