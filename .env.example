# ============================================================
# STIVELY-WEB - ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development.
# Never commit .env.local - it's already in .gitignore.
# In production, set these in Vercel's Environment Variables UI.
# ============================================================

# --- Database (PostgreSQL) ---
# Get this from Neon, Supabase, or Vercel Postgres. Must include ?sslmode=require
# for most managed providers.
DATABASE_URL="postgresql://user:password@host:5432/stively?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth - console.cloud.google.com > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#                           https://stively.com/api/auth/callback/google (prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend key used specifically by the Auth.js email/magic-link provider.
# Can be the same value as RESEND_API_KEY below.
AUTH_RESEND_KEY=""

# --- Resend (transactional email) ---
# resend.com > API Keys
RESEND_API_KEY=""
EMAIL_FROM="Stively <team@stively.com>"

# --- Cloudinary (image storage) ---
# cloudinary.com > Dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Razorpay (payments) ---
# dashboard.razorpay.com > Settings > API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# dashboard.razorpay.com > Settings > Webhooks (set once the webhook URL is live)
RAZORPAY_WEBHOOK_SECRET=""

# --- Cron (Vercel Cron - lead-intelligence discover/analyze-stale, whatsapp-cross-sell) ---
# A random string YOU choose. Vercel sends `Authorization: Bearer $CRON_SECRET`
# automatically on cron-triggered requests once this is set as a Vercel
# project env var - see src/features/lead-intelligence/server/cron-auth.ts.
# Was already required by existing cron routes but missing from this file.
CRON_SECRET=""

# --- Groq (AI - Sales CRM outreach, AI Tutor, Lead Intelligence, WhatsApp AI agent) ---
# console.groq.com > API Keys. Was missing from this file even though every
# AI feature in this codebase depends on it - added while wiring the
# WhatsApp AI reply engine (src/features/whatsapp/server/reply-engine.ts).
GROQ_API_KEY=""

# --- WhatsApp Cloud API (Meta) ---
# Everything below requires a Meta Business Account + WhatsApp Business
# Account (WABA) first - see the architecture audit's Meta-setup checklist.
# business.facebook.com > your Business > WhatsApp Accounts
#
# System User access token (permanent, not the default 24h token) -
# business.facebook.com > Business Settings > System Users > [your system user]
# > Generate Token, scope: whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=""
# developers.facebook.com > your App > WhatsApp > API Setup > Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=""
# Same API Setup page > WhatsApp Business Account ID. Not required for
# sending (only WHATSAPP_PHONE_NUMBER_ID is), but kept here for template
# management / future use.
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# developers.facebook.com > your App > App Settings > Basic > App Secret.
# Used to verify the X-Hub-Signature-256 header on every inbound webhook
# call - never skip configuring this in production.
WHATSAPP_APP_SECRET=""
# A random string YOU choose (e.g. `openssl rand -hex 32`) - entered both
# here and in Meta's webhook configuration screen. Meta's one-time GET
# verification challenge only succeeds if these match.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Approved Meta message template names (Meta assigns/reviews these - they
# cannot be chosen freely). Leave unset until each template is actually
# approved - the code checks for this and stays inert otherwise (see
# src/features/whatsapp/lib/config.ts). See the final implementation report
# for what each template needs to say.
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION=""
WHATSAPP_TEMPLATE_CROSS_SELL=""
WHATSAPP_TEMPLATE_LANGUAGE="en"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Analytics (optional - features degrade gracefully if unset) ---
# GA4: analytics.google.com > Admin > Data Streams > Measurement ID (starts with G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Microsoft Clarity: clarity.microsoft.com > Settings > Setup > Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
# Google Ads conversion tag: ads.google.com > Tools > Conversions > Google tag (starts with AW-)
NEXT_PUBLIC_GOOGLE_ADS_ID=""
# Meta/Facebook Pixel: business.facebook.com > Events Manager > Data Sources > (your pixel) > Settings - the numeric Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=""


cold_call_api="testing api key"