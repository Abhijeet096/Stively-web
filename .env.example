# ============================================================
# STIVELY-WEB - ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development.
# Never commit .env.local - it's already in .gitignore.
# In production, set these in Vercel's Environment Variables UI.
# ============================================================

# --- Database (PostgreSQL) ---
# Get this from Neon, Supabase, or Vercel Postgres. Must include ?sslmode=require
# for most managed providers.
DATABASE_URL="postgresql://user:password@host:5432/stively?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth - console.cloud.google.com > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#                           https://stively.com/api/auth/callback/google (prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend key used specifically by the Auth.js email/magic-link provider.
# Can be the same value as RESEND_API_KEY below.
AUTH_RESEND_KEY=""

# --- Resend (transactional email) ---
# resend.com > API Keys
RESEND_API_KEY=""
EMAIL_FROM="Stively <hello@stively.com>"

# --- Cloudinary (image storage) ---
# cloudinary.com > Dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Razorpay (payments) ---
# dashboard.razorpay.com > Settings > API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# dashboard.razorpay.com > Settings > Webhooks (set once the webhook URL is live)
RAZORPAY_WEBHOOK_SECRET=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Analytics (optional - features degrade gracefully if unset) ---
# GA4: analytics.google.com > Admin > Data Streams > Measurement ID (starts with G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Microsoft Clarity: clarity.microsoft.com > Settings > Setup > Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
