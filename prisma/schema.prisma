generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH.JS REQUIRED MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(STUDENT)

  /// Only meaningful for role CLIENT - collected on the Business
  /// registration form (src/lib/validations/auth.ts's registerSchema).
  /// Null for every other role.
  companyName String?

  /// Null for OAuth-only accounts (Google). Set for anyone who registered
  /// or set a password via the Credentials provider - see src/lib/auth.ts.
  password String?

  /// Account-lockout pair (see src/lib/auth.ts's Credentials `authorize()`):
  /// incremented on each failed password attempt, reset on success.
  /// `lockedUntil` is set once the threshold is hit and checked before any
  /// password comparison runs, so a locked account never reaches bcrypt.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// Bumped on every successful password change (registration counts as
  /// the first "change"). The `jwt` callback in src/lib/auth.ts rejects any
  /// token minted before this timestamp, which is how a stateless JWT
  /// session gets invalidated after a password reset without a session
  /// table to delete rows from.
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?

  accounts                Account[]
  sessions                Session[]
  enrollments             Enrollment[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  /// Optional link to a CRM staff identity - see TeamMember below for why
  /// this is a link, not a merge.
  teamMember TeamMember?

  /// Offerings audit trail - see Offering below. Nullable/SetNull like every
  /// other audit FK in this file: the offering must survive its creator's
  /// account being deleted.
  createdOfferings Offering[] @relation("OfferingCreatedBy")
  updatedOfferings Offering[] @relation("OfferingUpdatedBy")

  /// Every request this user has ever made (Draft through Completed) - see
  /// OfferingRequest below.
  offeringRequests OfferingRequest[]

  /// Every direct-purchase order this user has made - see Order below.
  orders Order[]

  /// Every Offering-based enrollment this user has, regardless of how it
  /// originated - see OfferingEnrollment below. Named distinctly from the
  /// `enrollments` field above (the legacy Program-tied Enrollment) -
  /// same parallel-systems reasoning as Offering/Program themselves.
  offeringEnrollments OfferingEnrollment[]

  /// Phase 10 (Mentor & Learning Delivery) - a MENTOR-role user's rich
  /// profile, if they have one. See Mentor below for why this is a
  /// dedicated model, not TeamMember.
  mentor Mentor?

  /// Every mentor this user has ever been assigned, as a student - see
  /// MentorAssignment below.
  mentorAssignments   MentorAssignment[]
  mentorConversations MentorConversation[]
  sentMessages        MentorMessage[]
  sessionAttendance   MentorSessionAttendee[]
  notifications       Notification[]

  /// Client Workspace - every SalesLead this CLIENT-role user has been
  /// linked to as the business's contact (see SalesLead.clientUserId).
  /// Usually one, but a repeat client's second engagement is a second,
  /// separate SalesLead - see the field comment there.
  clientOfLeads     SalesLead[]        @relation("SalesLeadClient")
  /// Sales Negotiation Loop - every message this user has sent on a
  /// SalesLead thread, either side (client or staff).
  salesLeadMessages SalesLeadMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Portal-level access role. STUDENT and CLIENT are the only two exposed on
/// the public registration form (see src/lib/validations/auth.ts's
/// registerSchema) - every other role is assigned internally by an admin.
/// Adding a future role (Recruiter, Investor, Partner, ...) is: one value
/// here + a migration + one line in each map in src/config/rbac.ts + a
/// route folder - nothing else in the auth system changes.
enum Role {
  STUDENT
  MENTOR
  CLIENT
  COMPANY
  INTERN
  TEAM_MEMBER
  ADMIN
  SUPER_ADMIN
  /// Sales CRM - a dedicated portal at /sales, distinct from ADMIN/TEAM_MEMBER
  /// so a sales hire gets least-privilege access (their own leads/dashboard
  /// only) instead of the broad /admin surface. TeamMember.role
  /// (SALESPERSON vs SALES_MANAGER) decides own-only vs whole-team
  /// visibility within this portal - see resolveSalesCrmViewer.
  SALES
}

/// Single-use token backing the "forgot password" flow
/// (src/actions/auth.ts's requestPasswordReset/resetPassword). Kept as its
/// own table rather than reusing Auth.js's VerificationToken below, which
/// is shaped for the adapter's own passwordless-provider flow, not an
/// arbitrary app-issued token.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Single-use token backing post-registration email verification
/// (src/actions/auth.ts's registerUser/resendVerificationEmail). See
/// PasswordResetToken above for why this isn't the adapter's
/// VerificationToken table.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Required by the Auth.js Prisma adapter's shape even though no configured
/// provider currently issues tokens into it (the Resend passwordless
/// provider that used this table was removed in favor of Credentials +
/// Google - see src/lib/auth.ts). Left in place rather than dropped, since
/// the adapter's type contract expects it to exist.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// TRAINING PROGRAMS
// ============================================

model Program {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  shortDescription String
  description      String       @db.Text
  level            ProgramLevel @default(BEGINNER)
  mode             ProgramMode  @default(ONLINE)
  durationWeeks    Int
  price            Int // smallest currency unit (paise)
  currency         String       @default("INR")
  startDate        DateTime?
  syllabus         Json // structured module/topic list
  outcomes         String[]
  featuredImageUrl String?
  seoTitle         String?
  seoDescription   String?
  published        Boolean      @default(false)

  enrollments Enrollment[]
  leads       Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProgramLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProgramMode {
  ONLINE
  OFFLINE
  HYBRID
}

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  programId  String
  status     EnrollmentStatus @default(PENDING)
  amountPaid Int
  paymentRef String? // gateway-agnostic external reference (Razorpay order/payment id)
  enrolledAt DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@unique([userId, programId])
}

enum EnrollmentStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

// ============================================
// LEAD CAPTURE (unified: contact, program interest, careers, newsletter popup)
// ============================================

model Lead {
  id       String       @id @default(cuid())
  leadType LeadType     @default(STUDENT)
  name     String
  /// Nullable - the /start-project ad-landing form deliberately doesn't
  /// require email (phone/WhatsApp is the real contact channel for that
  /// audience); every other lead-capture form on the site still collects
  /// it. Postgres allows multiple NULLs under @@unique([email, leadType]),
  /// so this doesn't weaken that constraint for leads that do have one.
  email    String?
  phone    String?
  message  String?      @db.Text
  source   LeadSource
  status   LeadStatus   @default(NEW)
  priority LeadPriority @default(MEDIUM)

  companyName    String?
  metadata       Json?
  estimatedValue Int? // paise, Business-only in practice
  lostReason     LostReason?
  nextFollowUpAt DateTime?
  lastEnquiryAt  DateTime    @default(now())

  acquisitionChannel AcquisitionChannel?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?

  currentOwnerId String?
  currentOwner   TeamMember? @relation(fields: [currentOwnerId], references: [id], onDelete: SetNull)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  /// Set once this Lead is qualified into the real B2B sales pipeline - same
  /// bridge shape as Business.promotedSalesLeadId/OfferingRequest.promotedSalesLeadId
  /// (see AD-001). Unique so the DB itself guarantees a Lead backs at most
  /// one SalesLead. Admin triggers this by setting status to CONVERTED (the
  /// BUSINESS-leadType UI labels this action "Qualify" - see qualifyLead).
  promotedSalesLeadId String?     @unique
  promotedSalesLead   SalesLead?  @relation("LeadPromotedTo", fields: [promotedSalesLeadId], references: [id], onDelete: SetNull)
  promotedAt          DateTime?
  promotedById        String?
  promotedBy          TeamMember? @relation("LeadPromotedBy", fields: [promotedById], references: [id], onDelete: SetNull)

  history     LeadHistory[]
  notes       LeadNote[]
  assignments LeadAssignment[]
  meetings    LeadMeeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, leadType])
  @@index([email])
  @@index([phone])
  @@index([nextFollowUpAt])
}

enum LeadType {
  STUDENT
  BUSINESS
}

enum AcquisitionChannel {
  WEBSITE
  GOOGLE_SEARCH
  GOOGLE_ADS
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  REFERRAL
  DIRECT
  INTERNSHALA
  NAUKRI
  INDEED
  MANUAL_ENTRY
  OTHER
}

enum LeadSource {
  CONTACT_FORM
  PROGRAM_INTEREST
  CAREERS
  NEWSLETTER_POPUP
  CLIENT_PORTAL
  /// The dedicated /start-project landing page built for paid ad traffic
  /// (Google Ads) - see submitStartProjectLead (src/actions/leads.ts).
  START_PROJECT
  OTHER
}

enum LeadStatus {
  NEW
  ASSIGNED
  FIRST_CALL
  INTERESTED
  CALLBACK_REQUESTED
  NOT_RESPONDED
  NOT_INTERESTED
  COUNSELLING
  ENROLLMENT
  PAYMENT
  INITIAL_CONTACT
  WHATSAPP_DISCUSSION
  DISCOVERY_CALL
  REQUIREMENTS_GATHERING
  PROPOSAL_SENT
  NEGOTIATION
  PROJECT_APPROVED
  DEVELOPMENT_STARTED
  CONVERTED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum LostReason {
  FINANCIAL_ISSUE
  PARENTS_REJECTED
  JOINED_ANOTHER_INSTITUTE
  NO_TIME
  NOT_ELIGIBLE
  BUDGET_ISSUE
  COMPETITOR_WON
  ALREADY_HIRED_AGENCY
  INTERNAL_TEAM
  POSTPONED
  CANCELLED
  NO_RESPONSE
}

// ============================================
// TEAM / OWNERSHIP (not authentication - see TeamMember below)
// ============================================

/// Not itself an authentication identity - no password, no session. Exists
/// so lead ownership can be a real foreign key instead of free-text.
/// `userId` optionally links a staff member's real login (`User`, typically
/// role TEAM_MEMBER/ADMIN/SUPER_ADMIN) to their CRM ownership record - see
/// src/actions/crm.ts's resolveActorId(), which now reads this link instead
/// of guessing an actor. Deliberately a link, not a merge into User: CRM
/// ownership semantics (FOUNDER/SALESPERSON/ADMIN below) are a distinct
/// concept from portal access role, and merging would force every future
/// staff hire through a CRM-specific onboarding step just to get a login.
model TeamMember {
  id     String         @id @default(cuid())
  name   String
  email  String         @unique
  role   TeamMemberRole
  userId String?        @unique
  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  ownedLeads  Lead[]
  assignments LeadAssignment[] @relation("AssignmentOwner")

  /// Phase 7 (Operations Engine) - see OperationItem below. Separate from
  /// `ownedLeads`/`assignments` above (Lead's own CRM) on purpose - the two
  /// systems are parallel, not merged, per OperationItem's model comment.
  assignedOperationItems OperationItem[]       @relation("OperationAssignee")
  operationAssignments   OperationAssignment[] @relation("OperationAssignmentAssignee")
  assignmentsMade        OperationAssignment[] @relation("OperationAssignmentAssignedBy")
  activityLogs           ActivityLog[]
  internalComments       InternalComment[]
  scheduledMeetings      Meeting[]
  accessGrantsGiven      AccessGrant[]

  /// Phase 9 (Learning Platform) - instructor/reviewer prep, not a full instructor portal yet.
  ledLearningExperiences LearningExperience[]
  hostedLiveSessions     LiveSession[]
  reviewedSubmissions    AssessmentSubmission[]
  createdResources       Resource[]

  /// Offering Request assignment - see OfferingRequest below. A counsellor
  /// and a salesperson are distinct assignment slots on the same request
  /// (a Student request only ever fills the former, a Business request
  /// only the latter), not two competing owner concepts.
  counsellingRequests OfferingRequest[] @relation("RequestCounsellor")
  salesRequests       OfferingRequest[] @relation("RequestSalesPerson")
  quoteReviewsGiven   OfferingRequest[] @relation("RequestQuoteReviewedBy")

  /// Phase 10 (Mentor & Learning Delivery) - set only for staff who are
  /// *also* an internal mentor (Mentor.affiliatedTeamMemberId below), not
  /// required for every TeamMember.
  mentorProfile         Mentor?
  mentorAssignmentsMade MentorAssignment[]

  /// AI Interview Platform - see Job below.
  createdJobs Job[]

  /// Sales CRM - see SalesLead below. Separate from `ownedLeads`/
  /// `assignments` (the inbound-marketing Lead CRM) on purpose, same
  /// "parallel, not merged" reasoning as `assignedOperationItems` above -
  /// this is outbound B2B sales prospecting, a different data shape and
  /// pipeline entirely.
  salesProfile                SalesProfile?
  ownedSalesLeads             SalesLead[]              @relation("SalesLeadAssignedTo")
  createdSalesLeads           SalesLead[]              @relation("SalesLeadCreatedBy")
  salesLeadAssignments        SalesLeadAssignment[]    @relation("SalesAssignmentOwner")
  salesLeadAssignmentsMade    SalesLeadAssignment[]    @relation("SalesAssignmentAssignedBy")
  salesLeadActivities         SalesLeadActivity[]
  salesLeadOutreachGenerated  SalesLeadOutreach[]
  salesLeadDiscoveriesUpdated SalesLeadDiscovery[]
  proposalsCreated            Proposal[]
  proposalVersionsCreated     ProposalVersion[]
  proposalMeetingsConfirmed   ProposalMeetingRequest[]
  salesLeadNotes              SalesLeadNote[]
  salesLeadAttachments        SalesLeadAttachment[]
  salesQuotesCreated          SalesQuote[]
  scheduledSalesLeadMeetings  SalesLeadMeeting[]
  scheduledLeadMeetings       LeadMeeting[]
  assignedFollowUps           SalesFollowUp[]          @relation("FollowUpAssignee")
  createdFollowUps            SalesFollowUp[]          @relation("FollowUpCreatedBy")
  assignedTasks               SalesTask[]              @relation("TaskAssignee")
  createdTasks                SalesTask[]              @relation("TaskAssignedBy")
  salesProjectsAsSales        SalesProject[]           @relation("ProjectSalesPerson")
  salesProjectsAsManager      SalesProject[]           @relation("ProjectManager")
  salesProjectsAsDev          SalesProject[]           @relation("ProjectDeveloper")
  recordedPayments            SalesProjectPayment[]
  commissionsEarned           SalesCommission[]        @relation("CommissionSalesPerson")
  commissionsApproved         SalesCommission[]        @relation("CommissionApprovedBy")

  /// Client Workspace - see ClientDocument/ProjectUpdate above.
  uploadedClientDocuments ClientDocument[]
  postedProjectUpdates    ProjectUpdate[]

  /// AI Lead Intelligence Platform - see Business below. Upstream of the
  /// Sales CRM above, deliberately not merged into it.
  businessesCreated         Business[]                  @relation("BusinessCreatedBy")
  businessesPromoted        Business[]                  @relation("BusinessPromotedBy")
  leadIntelligenceRuns      LeadIntelligenceSearchRun[]
  leadScoringConfigsCreated LeadScoringConfig[]
  businessActivities        BusinessActivity[]
  auditLogEntries           AuditLog[]

  /// Lead -> SalesLead qualification bridge - see Lead.promotedById above.
  leadsPromoted Lead[] @relation("LeadPromotedBy")

  /// Client Discovery & Requirements Form - see DiscoveryForm below.
  discoveryFormsSent     DiscoveryForm[] @relation("DiscoveryFormSentBy")
  discoveryFormsReviewed DiscoveryForm[] @relation("DiscoveryFormReviewedBy")

  /// Post-approval kickoff form - see OnboardingForm below.
  onboardingFormsSent     OnboardingForm[] @relation("OnboardingFormSentBy")
  onboardingFormsReviewed OnboardingForm[] @relation("OnboardingFormReviewedBy")

  createdAt DateTime @default(now())
}

/// FOUNDER doubles as "CEO" full access and ADMIN as Operations-full-access
/// in the Phase 7 Operations Engine's RBAC (see OperationItem below) -
/// COUNSELLOR/SUPPORT added for that phase, additive to the pre-existing
/// three values Lead's CRM already uses.
enum TeamMemberRole {
  FOUNDER
  SALESPERSON
  ADMIN
  COUNSELLOR
  SUPPORT
  /// AI Interview Platform - purely descriptive/attribution, same as every
  /// other value here (see Job.createdBy) - not a separate hard-gated
  /// permission tier. /admin/interviews/* access is still governed by
  /// User.role (ADMIN/SUPER_ADMIN) via src/config/rbac.ts, same as every
  /// other admin surface.
  RECRUITER
  /// Sales CRM - leads a team of SALESPERSON TeamMembers, sees the whole
  /// team's pipeline/commission via resolveSalesCrmViewer (full access,
  /// same tier as FOUNDER/ADMIN there), distinct from SALESPERSON (whose
  /// visibility is restricted to their own assigned SalesLeads).
  SALES_MANAGER
}

/// Append-only event timeline for a Lead - every meaningful action gets an
/// event (created, re-enquiry, assigned, reassigned, status changed, note
/// added, converted), not just status changes.
model LeadHistory {
  id          String        @id @default(cuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  eventType   LeadEventType
  fromStatus  LeadStatus?
  toStatus    LeadStatus?
  description String?       @db.Text
  performedBy String?

  createdAt DateTime @default(now())
}

enum LeadEventType {
  LEAD_CREATED
  RE_ENQUIRY
  ASSIGNED
  REASSIGNED
  /// A Role.SALES rep self-assigns an unclaimed lead via claimLead -
  /// distinct from ASSIGNED/REASSIGNED, which are admin-driven.
  CLAIMED
  CALL_ATTEMPTED
  WHATSAPP_SENT
  FOLLOW_UP_SCHEDULED
  STATUS_CHANGED
  NOTE_ADDED
  CONVERTED
  MEETING_SCHEDULED
}

/// Manual, human notes - kept structurally separate from LeadHistory
/// (automatic system events) on purpose. Create-only, no edit/delete.
model LeadNote {
  id       String  @id @default(cuid())
  leadId   String
  lead     Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content  String  @db.Text
  authorId String?

  createdAt DateTime @default(now())
}

/// Append-only ownership log. Every lead always has exactly one active
/// assignment at a time; reassigning marks the current one inactive and
/// creates a new one rather than overwriting it.
model LeadAssignment {
  id           String             @id @default(cuid())
  leadId       String
  lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        TeamMember         @relation("AssignmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignedById String?
  reason       ReassignmentReason @default(INITIAL)
  isActive     Boolean            @default(true)

  createdAt DateTime @default(now())
}

enum ReassignmentReason {
  INITIAL
  SLA_BREACH
  UNAVAILABLE
  MANUAL_OVERRIDE
}

// ============================================
// NEWSLETTER
// ============================================

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  status         SubscriberStatus @default(ACTIVE)
  source         String?
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

// ============================================
// TESTIMONIALS
// ============================================

model Testimonial {
  id          String  @id @default(cuid())
  studentName String
  studentRole String?
  avatarUrl   String?
  quote       String  @db.Text
  rating      Int?
  programId   String?
  published   Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
}

/// Purely descriptive/filterable category for a showcased demo site - drives
/// a client-side filter chip, nothing else. Adding a new category later is
/// one enum value, same "don't hardcode behavior per type" reasoning used
/// throughout this schema (LessonBlockType, MentorType, etc.).
enum PortfolioCategory {
  WEBSITE
  WEB_APP
  ECOMMERCE
  MOBILE_APP
  BRANDING
  OTHER
}

/// A real, shipped demo/client site shown on the public "Our Work" page, a
/// homepage teaser, and (as of the case-study expansion) a full detail page
/// at /work/[slug] - the concrete proof the homepage's ServicesGrid comment
/// says doesn't exist yet ("no fabricated case studies... none exist yet to
/// show honestly"). Admin-managed via /admin/portfolio (PF1-PF9) - the 3
/// original rows predate that UI and were inserted by hand, which is why
/// `slug` is nullable at the DB layer (backfilled once) despite being
/// required at the Zod/admin-form layer for every new item.
model PortfolioItem {
  id String @id @default(cuid())

  /// Nullable only for the pre-admin-UI legacy rows (backfilled once) - the
  /// admin form always requires one for new items. Powers /work/[slug].
  slug String? @unique

  title      String
  /// Short hero subheading, distinct from `summary` (which becomes the
  /// detail page's longer "Overview" section body).
  tagline    String?
  /// Null for a self-initiated "Portfolio Concept" piece (no real client) -
  /// that null-ness IS the Portfolio-Concept-vs-Client-Project distinction,
  /// not a separate field. Set to a real name for actual client work.
  clientName String?
  /// The vertical this project is for (e.g. "Interior Design", "Fitness",
  /// "Healthcare") - distinct from `category` above, which is the *kind* of
  /// build (Website/Web App/...), not who it's for.
  industry   String?
  category   PortfolioCategory @default(WEBSITE)
  summary    String            @db.Text

  /// Case-study narrative sections - all optional, all rendered on
  /// /work/[slug] only when present. Never fabricated/placeholder content
  /// for items that don't have real case-study material yet (matches this
  /// model's own established no-fabrication precedent above).
  challenge String?  @db.Text
  solution  String?  @db.Text
  /// Array<{ title: string; description: string }>
  features  Json?
  techStack String[] @default([])
  /// Array<{ label: string; value: string }> - real metrics only, never
  /// invented to fill the section.
  outcomes  Json?

  imageUrl      String
  /// Device-mockup screenshots (already framed to look like a viewport) -
  /// shown wrapped in a lightweight CSS device frame on the detail page.
  mockupImages  String[] @default([])
  /// Additional real screenshots shown in a plain gallery grid.
  galleryImages String[] @default([])
  liveUrl       String?
  tags          String[]

  /// Pins an item to the front of both the homepage teaser and the full
  /// grid, ahead of sortOrder - lets whoever manages content promote a
  /// strongest-piece-first without reordering everything else.
  featured  Boolean @default(false)
  published Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

// ============================================
// OFFERINGS PLATFORM (Phase 4 - core product catalog)
// ============================================
//
// The single reusable business entity every product line sells through -
// Training, Internships, Software Development, AI Solutions, Digital
// Marketing, Career Guidance, Corporate Training, and future SaaS products
// all live here as one Offering with a different `category`, rather than a
// bespoke table per product line. Modeled after Shopify's single Product
// entity spanning wildly different product types.
//
// Deliberately independent from Program/Enrollment/Lead above: this is a
// new, additive system, not a migration of Training onto a new table.
// Program keeps powering /training and the existing CRM relations
// (Lead.programId, Enrollment.programId) untouched. Migrating that legacy
// data into Offering and redirecting /training -> /offerings/training is
// planned as a deliberate follow-up phase, not a big-bang rename bundled
// into this one - see docs/PROJECT_STATUS.md.
//
// Future relations intentionally NOT modeled as real tables yet (per the
// brief: "prepare scalable relations, do not fully implement future
// tables") - added here as a real FK/join table only once each concept
// needs to be more than a display string:
//   - Instructor / Mentor as a formal entity (today: Offering.instructorName,
//     a plain string)
//   - Testimonial FK'd to Offering (today: a placeholder UI section, no
//     fabricated content - see OfferingTestimonialsPlaceholder)
//   - FAQ / Module / Resource / Document as first-class tables (today:
//     Offering.faqs / Offering.curriculum as validated Json, same
//     convention as Program.syllabus)
//   - Tag as a many-to-many join table (today: Offering.tags, a plain
//     String[], same convention as Program.outcomes)
model Offering {
  id   String @id @default(cuid())
  slug String @unique

  // Basic information
  title            String
  shortDescription String
  longDescription  String           @db.Text
  category         OfferingCategory
  audience         OfferingAudience
  status           OfferingStatus   @default(DRAFT)
  featured         Boolean          @default(false)
  /// Distinct from `status`: a Published offering can still be hidden from
  /// browse/search (e.g. shared only via direct link) without archiving it.
  visible          Boolean          @default(true)
  /// Which CTA(s) this offering shows (Phase 6) - a well-understood, fixed-
  /// price offering (a course, a starter website package) can skip the
  /// request-engine wizard entirely via DIRECT_PAYMENT; something that
  /// needs scoping (AI Automation, custom software) stays CONSULTATION;
  /// BOTH shows a "Buy Now" alongside the guidance path, e.g. a course
  /// with an optional "talk to an advisor first" out. Defaults to
  /// CONSULTATION so every offering seeded before this field existed keeps
  /// behaving exactly as it did in Phase 5.
  purchaseFlow     PurchaseFlow     @default(CONSULTATION)

  // Business information
  /// Smallest currency unit (paise), same convention as Program.price.
  /// Null for Free and Custom Quote pricing types, where a fixed number
  /// doesn't apply.
  price         Int?
  currency      String      @default("INR")
  discountPrice Int?
  pricingType   PricingType @default(FIXED)
  /// Free-text display duration ("6 Months", "4 Weeks", "Ongoing") - values
  /// vary too widely across categories (a training cohort vs. a dev project
  /// timeline) for one numeric bucket to fit both.
  duration      String?
  mode          Mode        @default(ONLINE)
  difficulty    Difficulty?
  capacity      Int?

  // Content blocks - mirrors Program's Json/String[] convention rather than
  // inventing a new pattern for structured-but-flexible content.
  whatYoullLearn String[]
  benefits       String[]
  whoItsFor      String[]
  requirements   String[]
  /// Array of {question, answer} - validated by
  /// src/features/offerings/lib/faq.ts, same pattern as Program.syllabus's
  /// parseSyllabus.
  faqs           Json?
  /// {modules: [{title, topics}]} - reuses Program.syllabus's exact shape.
  curriculum     Json?

  // Media
  thumbnailUrl String?
  bannerUrl    String?
  gallery      String[]

  // Lightweight future-relation fields - see the model-level comment above.
  instructorName String?
  tags           String[]

  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String[]

  // Publishing / audit
  publishedAt DateTime?
  createdById String?
  updatedById String?
  createdBy   User?     @relation("OfferingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("OfferingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  /// Incremented on each detail-page render - a real, cheap "Popular" sort
  /// signal. Naive (counts crawler hits too) but honest: no fabricated
  /// popularity score. Revisit once real analytics exist.
  viewCount Int @default(0)

  /// Every Enroll/Request Proposal ever started against this offering -
  /// see OfferingRequest below.
  requests OfferingRequest[]

  /// Every direct-purchase order made against this offering - see Order below.
  orders Order[]

  /// Every enrollment created against this offering - see OfferingEnrollment below.
  offeringEnrollments OfferingEnrollment[]

  /// Every Sales CRM quote that referenced this offering's price as a
  /// starting point - see SalesQuote. A B2B outbound deal, not a Request/
  /// Order (which are inbound self-serve), so it's a separate relation.
  salesQuotes SalesQuote[]

  /// The curriculum behind this offering, if it has one - see
  /// LearningExperience below. Optional 1:1: only some categories
  /// (Training, Internship, Corporate Training) ever have curriculum: a
  /// Custom Software Development offering never will.
  learningExperience LearningExperience?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([audience])
  @@index([status])
  @@index([featured])
}

enum OfferingCategory {
  TRAINING
  INTERNSHIP
  SOFTWARE_DEVELOPMENT
  WEBSITE_DEVELOPMENT
  MOBILE_DEVELOPMENT
  AI_SOLUTIONS
  DIGITAL_MARKETING
  CAREER_GUIDANCE
  CORPORATE_TRAINING
  SAAS
}

enum OfferingAudience {
  STUDENT
  BUSINESS
  BOTH
}

enum OfferingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  COMING_SOON
}

enum PricingType {
  FREE
  FIXED
  SUBSCRIPTION
  CUSTOM_QUOTE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Mode {
  ONLINE
  OFFLINE
  HYBRID
}

enum PurchaseFlow {
  DIRECT_PAYMENT
  CONSULTATION
  BOTH
}

// ============================================
// OFFERING REQUEST ENGINE (Phase 5)
// ============================================
//
// The one workflow engine connecting an Offering to a customer becoming a
// customer. A Student clicking "Enroll" and a Business clicking "Request
// Proposal" both create an OfferingRequest, differing only by
// `requestType` - not two separate Enrollment/Proposal tables. Both flow
// through the same RequestStatus lifecycle until they naturally diverge
// into (future, not built here) Enrollment/Project territory.
//
// Deliberately NOT Payments/CRM/Enrollment/Projects - this model only
// carries the request itself plus the extension points those future
// phases plug into: assignedCounsellorId/assignedSalesPersonId (empty FKs
// today), paymentStatus (tracked, never charged), and
// src/features/offering-requests/lib/events.ts's emitOfferingRequestEvent
// stub (the one call site real email/notifications will eventually wire
// into, so that's a body-only change later, not a new call-site hunt).
model OfferingRequest {
  id String @id @default(cuid())

  /// Backs the human-friendly requestNumber (formatRequestNumber() in
  /// src/features/offering-requests/lib/request-number.ts) - derived from
  /// this at render time rather than stored as its own redundant text
  /// column. One sequence for both request types on purpose: one engine,
  /// one numbering scheme, not a Student counter and a Business counter.
  sequence Int @unique @default(autoincrement())

  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  requestType RequestType
  status      RequestStatus   @default(DRAFT)
  priority    RequestPriority @default(MEDIUM)

  /// The wizard's resume point (src/features/offering-requests/components/
  /// wizard/request-wizard.tsx) and what a request list card shows for a
  /// still-Draft request ("Current Step").
  currentStep Int @default(1)

  /// Future CRM assignment - both nullable/SetNull, both unset until
  /// Phase 6 builds the CRM surface that assigns them.
  assignedCounsellorId  String?
  assignedCounsellor    TeamMember? @relation("RequestCounsellor", fields: [assignedCounsellorId], references: [id], onDelete: SetNull)
  assignedSalesPersonId String?
  assignedSalesPerson   TeamMember? @relation("RequestSalesPerson", fields: [assignedSalesPersonId], references: [id], onDelete: SetNull)

  paymentStatus PaymentStatus @default(NOT_REQUIRED)

  /// Client-proposed custom price negotiation - independent of `status`
  /// (the overall admin review pipeline), since a price can be pending/
  /// rejected/re-proposed without moving the request through that
  /// pipeline. See proposeCustomQuote/approveCustomQuote/rejectCustomQuote.
  proposedAmount       Int?
  proposedMessage      String?             @db.Text
  quoteStatus          RequestQuoteStatus?
  /// Set by admin on approval - what the client actually pays, may differ
  /// from proposedAmount if the admin countered instead of accepting as-is.
  approvedAmount       Int?
  quoteReviewedById    String?
  quoteReviewedBy      TeamMember?         @relation("RequestQuoteReviewedBy", fields: [quoteReviewedById], references: [id], onDelete: SetNull)
  quoteReviewedAt      DateTime?
  quoteRejectionReason String?

  /// Set once the client pays approvedAmount - a real Order created via
  /// createOrderFromApprovedQuote, running through the exact same
  /// verifyPayment/webhook/notifyOrderPaid machinery as a normal direct
  /// checkout. The Order's own status is the payment source of truth, not
  /// a duplicated flag here - this request's own `status` field is left
  /// alone (admin-controlled workflow stage, not payment state).
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Set when a CLIENT-role request's custom quote is approved - bridges
  /// this self-service request into the same rich Sales CRM pipeline
  /// (quotes/meetings/chat/installments/documents) a cold-called SalesLead
  /// already gets, instead of a second, thinner payment system just for
  /// this origin. Origin-side FK (not created-side, unlike
  /// OfferingEnrollment.offeringRequestId) so this page can redirect off a
  /// single cheap field read, same shape as Business.promotedSalesLeadId.
  /// See approveCustomQuote (admin-quote-actions.ts).
  promotedSalesLeadId String?    @unique
  promotedSalesLead   SalesLead? @relation("OfferingRequestPromotedTo", fields: [promotedSalesLeadId], references: [id], onDelete: SetNull)

  /// Requestype-specific wizard step data - one flexible field rather than
  /// a studentDetails/businessDetails pair that's always half-empty. Shape
  /// validated by src/features/offering-requests/validation/step-schemas.ts,
  /// same Json+Zod convention as Offering.faqs/curriculum (Phase 4).
  details Json?

  notes                  String?                 @db.Text
  /// Staff-only - never rendered on any user-facing surface. Future CRM.
  internalNotes          String?                 @db.Text
  preferredContactMethod PreferredContactMethod?
  preferredMeetingTime   String?

  /// Where this request originated - "offering-detail", "dashboard", etc.
  /// Plain string, not an enum: an open-ended, low-cardinality tag, not a
  /// closed set the schema needs to enforce.
  source String?

  submittedAt DateTime?
  approvedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  history OfferingRequestHistory[]

  /// Set once this request is Submitted - see OperationItem below and
  /// createOperationItemForRequest() (src/features/operations/server/creation.ts).
  /// Null while still a Draft.
  operationItem OperationItem?

  /// Set once this request is Approved - see OfferingEnrollment below and
  /// createEnrollmentFromRequest() (src/features/enrollments/server/creation.ts).
  enrollment OfferingEnrollment?

  @@index([userId])
  @@index([offeringId])
  @@index([status])
  @@index([requestType])
}

enum RequestType {
  STUDENT
  BUSINESS
}

enum RequestQuoteStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  COUNSELLING_SCHEDULED
  WAITING_FOR_PAYMENT
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

/// Named RequestPriority, not bare "Priority" - LeadPriority already exists
/// above in this file for a different concept, and the Request- prefix
/// matches RequestType/RequestStatus for consistency.
enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED
}

enum PreferredContactMethod {
  EMAIL
  PHONE
  WHATSAPP
  GOOGLE_MEET
  ZOOM
}

/// Append-only event timeline for an OfferingRequest - the Status Timeline
/// every request detail page renders. Mirrors LeadHistory above exactly:
/// every meaningful action gets its own event, not just status changes.
model OfferingRequestHistory {
  id          String           @id @default(cuid())
  requestId   String
  request     OfferingRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  eventType   RequestEventType
  fromStatus  RequestStatus?
  toStatus    RequestStatus?
  description String?
  performedBy String?

  createdAt DateTime @default(now())

  @@index([requestId])
}

enum RequestEventType {
  CREATED
  STEP_SAVED
  SUBMITTED
  STATUS_CHANGED
  COUNSELLOR_ASSIGNED
  SALESPERSON_ASSIGNED
  NOTE_ADDED
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  QUOTE_PROPOSED
  QUOTE_APPROVED
  QUOTE_REJECTED
}

// ============================================
// ORDERS (Phase 6 - direct-purchase checkout)
// ============================================
//
// The "pay right now" counterpart to OfferingRequest above - deliberately
// a separate model, not a repurposing of it. OfferingRequest stays the
// human-assisted, multi-step guidance path (Enroll/Request Proposal on a
// CONSULTATION offering); Order is the one-click Razorpay checkout path
// (Buy Now on a DIRECT_PAYMENT/BOTH offering - see Offering.purchaseFlow).
// A single BOTH-flow offering can accumulate both an OfferingRequest (from
// someone who asked for guidance first) and an Order (from someone who
// just bought it) - that's expected, not a conflict.
//
// No formal Enrollment/Project record is created on payment yet - that's
// Phase 8 (Enrollment Engine) / Phase 10 (Business Project Management) on
// the roadmap. A PAID Order is the access/ownership signal for now; when
// those phases land, they read `Order.status = PAID` to know what to
// materialize into a real Enrollment/Project.
model Order {
  id String @id @default(cuid())

  /// Backs the human-friendly orderNumber (formatOrderNumber() in
  /// src/features/orders/lib/order-number.ts), derived rather than stored -
  /// same convention as OfferingRequest.sequence.
  sequence Int @unique @default(autoincrement())

  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Paise, snapshotted at purchase time - an Offering's price changing
  /// later must never retroactively change what a paid order actually
  /// cost. Zero for a FREE + DIRECT_PAYMENT offering (see createOrder()'s
  /// free-offering short-circuit - no Razorpay order exists for those).
  amount   Int
  currency String      @default("INR")
  status   OrderStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  razorpaySignature String?

  /// Minimal contact capture at checkout, only ever asked for if not
  /// otherwise known - see the checkout page's phone-prompt logic.
  phone String?
  notes String? @db.Text

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Set once this order is Paid - see OperationItem below and
  /// createOperationItemForOrder() (src/features/operations/server/creation.ts).
  /// Null while still Pending/Failed - an unpaid order shouldn't clutter Operations.
  operationItem OperationItem?

  /// Set once this order is Paid - see OfferingEnrollment below and
  /// createEnrollmentFromOrder() (src/features/enrollments/server/creation.ts).
  enrollment OfferingEnrollment?

  /// Set when this Order was created to pay an admin-approved custom
  /// quote (createOrderFromApprovedQuote) rather than a normal fixed-price
  /// checkout - see OfferingRequest.orderId above.
  offeringRequestQuote OfferingRequest?

  @@index([userId])
  @@index([offeringId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

// ============================================
// OPERATIONS ENGINE (Phase 7 - internal CRM/ops layer)
// ============================================
//
// The internal team's operating layer over OfferingRequest and Order - not
// a second status system. OfferingRequest.status/Order.status remain the
// real, actively-written source of truth (Phase 5/6's own actions
// maintain them, with their own history tables); OperationItem is a thin
// unifying pointer + operational metadata row (assignment, priority, due
// date, activity log, notes, meetings) that both types share, so staff
// have one queue instead of two.
//
// Deliberately does NOT absorb Lead (the pre-existing contact-form CRM at
// /admin/leads, with its own LeadHistory/LeadNote/LeadAssignment) - that's
// a second, deliberate instance of the Program/Offering-style parallel-
// systems call from Phase 4. Retrofitting a live, working CRM into this
// new model is exactly the kind of unasked-for, high-risk change the
// "don't modify previous phases" rule exists to prevent.
model OperationItem {
  id String @id @default(cuid())

  /// Backs the human-friendly OPS-000123 reference
  /// (src/features/operations/lib/operation-number.ts), derived rather
  /// than stored - same convention as Order/OfferingRequest.sequence.
  sequence Int @unique @default(autoincrement())

  type OperationItemType

  /// Exactly one of requestId/orderId is set - enforced by
  /// createOperationItemForRequest()/createOperationItemForOrder()
  /// (src/features/operations/server/creation.ts), not a DB constraint.
  requestId String?          @unique
  request   OfferingRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderId   String?          @unique
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   TeamMember? @relation("OperationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  priority   OperationPriority @default(MEDIUM)
  dueDate    DateTime?
  /// Free-text "what happens next" note staff set for themselves/each other - not a formal workflow state.
  nextAction String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments OperationAssignment[]
  activities  ActivityLog[]
  comments    InternalComment[]
  meetings    Meeting[]

  @@index([assignedToId])
  @@index([type])
}

enum OperationItemType {
  REQUEST
  ORDER
}

enum OperationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Append-only, one active assignee at a time - mirrors LeadAssignment
/// exactly (see that model's comment for the full reasoning), just scoped
/// to OperationItem instead of Lead.
model OperationAssignment {
  id String @id @default(cuid())

  operationItemId String
  operationItem   OperationItem @relation(fields: [operationItemId], references: [id], onDelete: Cascade)

  assigneeId   String
  assignee     TeamMember  @relation("OperationAssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   TeamMember? @relation("OperationAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  role     AssignmentRole
  /// Reused from Lead's CRM (see ReassignmentReason above) - the same three reasons apply to reassigning ops work.
  reason   ReassignmentReason @default(INITIAL)
  isActive Boolean            @default(true)

  createdAt DateTime @default(now())

  @@index([operationItemId])
}

/// MENTOR is deliberately unimplemented today - no TeamMemberRole exists
/// for it (the brief explicitly excludes building a Mentor System this
/// phase). Kept in the enum as an honest, documented extension point:
/// assigning one would fail validation until a real Mentor staff role exists.
enum AssignmentRole {
  COUNSELLOR
  SALES
  SUPPORT
  MENTOR
}

/// The unified timeline every OperationItem detail page renders - every
/// meaningful action gets an entry, same "real event log, not just status
/// changes" discipline as LeadHistory.
model ActivityLog {
  id String @id @default(cuid())

  operationItemId String
  operationItem   OperationItem @relation(fields: [operationItemId], references: [id], onDelete: Cascade)

  type        ActivityType
  description String?
  /// Structured extra detail (e.g. {fromStatus, toStatus}) - kept flexible per activity type rather than a column per possible detail.
  metadata    Json?

  performedById String?
  performedBy   TeamMember? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([operationItemId])
}

enum ActivityType {
  CREATED
  ASSIGNED
  REASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  MEETING_SCHEDULED
  PAYMENT_RECEIVED
  NOTE_ADDED
  COMPLETED
}

/// Staff-only notes - never shown to the customer. Plain text today;
/// rendering it through a markdown formatter later is a display-only
/// upgrade, not a schema change ("rich text ready" without building an
/// editor this phase).
model InternalComment {
  id String @id @default(cuid())

  operationItemId String
  operationItem   OperationItem @relation(fields: [operationItemId], references: [id], onDelete: Cascade)

  authorId String?
  author   TeamMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  content String @db.Text

  createdAt DateTime @default(now())

  @@index([operationItemId])
}

/// A real, lightweight scheduling record - no calendar sync, no video-link
/// generation. The brief explicitly excludes building Calendar/Video
/// Meetings; this is just the data staff need to know a meeting exists.
model Meeting {
  id String @id @default(cuid())

  operationItemId String
  operationItem   OperationItem @relation(fields: [operationItemId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  /// Reused from Phase 5 (see PreferredContactMethod above) - Google Meet/Zoom/Phone/WhatsApp/Email already covers meeting method, no need for a duplicate enum.
  method      PreferredContactMethod?
  notes       String?
  status      MeetingStatus           @default(SCHEDULED)

  scheduledById String?
  scheduledBy   TeamMember? @relation(fields: [scheduledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([operationItemId])
  @@index([scheduledAt])
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ============================================
// ENROLLMENT & ACCESS ENGINE (Phase 8)
// ============================================
//
// Turns a Paid Order or an Approved OfferingRequest into actual student
// access - the one thing Phase 7 didn't close the loop on (staff could act
// on a request/order, but nothing unlocked anything for the customer).
// Explicitly not an LMS: no lessons, no modules, no real certificates -
// just the access record and audit trail every future learning feature
// will check against (see the Access Policy comment below).
//
// Origin-agnostic by design: `orderId` and `offeringRequestId` are both
// nullable and mutually exclusive in practice (enforced in
// createEnrollmentFromOrder()/createEnrollmentFromRequest(), not a DB
// constraint - same pattern as OperationItem's requestId/orderId), with
// room for a third, admin-created-directly origin (both null) that no
// Order or OfferingRequest backs at all.
//
// A request-originated Enrollment intentionally does NOT always start
// ACTIVE: the brief's own Consultation flow lists "Approved -> Payment
// (future) -> Enrollment" - online payment for requests isn't built.
// createEnrollmentFromRequest() starts PENDING (accessGranted: false) for
// any paid offering, and only auto-activates a FREE one immediately
// (nothing left to wait for). An admin activates the PENDING kind once
// payment is confirmed offline - see actions/admin-enrollment-actions.ts.
model OfferingEnrollment {
  id String @id @default(cuid())

  /// Backs the human-friendly ENR-000123 reference
  /// (src/features/enrollments/lib/enrollment-number.ts), derived rather
  /// than stored - same convention as every other sequence in this schema.
  sequence Int @unique @default(autoincrement())

  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  orderId           String?          @unique
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  offeringRequestId String?          @unique
  offeringRequest   OfferingRequest? @relation(fields: [offeringRequestId], references: [id], onDelete: SetNull)

  status OfferingEnrollmentStatus @default(PENDING)

  startDate      DateTime?
  endDate        DateTime?
  completionDate DateTime?

  /// Denormalized "current value" fields the dashboard/My Learning page
  /// read cheaply - derived, not hand-set: recalculateEnrollmentProgress()
  /// (src/features/learning/server/progression.ts) is the only writer,
  /// recomputing both from real LessonProgress rows every time a lesson's
  /// progress changes. ProgressSnapshot below is the historical log.
  currentModule      String?
  progressPercentage Int     @default(0)

  accessGranted   Boolean   @default(false)
  accessGrantedAt DateTime?
  accessRevokedAt DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history           EnrollmentHistory[]
  accessGrants      AccessGrant[]
  progressSnapshots ProgressSnapshot[]

  /// Phase 9 (Learning Platform) - see LessonProgress/AssessmentSubmission/
  /// Certificate below.
  lessonProgress        LessonProgress[]
  assessmentSubmissions AssessmentSubmission[]
  certificate           Certificate?

  /// Phase 10 (Mentor & Learning Delivery) - program-specific mentor
  /// assignments scoped to this enrollment. See MentorAssignment below.
  mentorAssignments MentorAssignment[]

  @@index([studentId])
  @@index([offeringId])
  @@index([status])
}

/// Named distinctly from the legacy Program-tied `EnrollmentStatus` above -
/// same parallel-systems reasoning as OfferingEnrollment itself.
enum OfferingEnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  EXPIRED
}

/// The Enrollment Timeline - mirrors LeadHistory/OfferingRequestHistory
/// exactly, just scoped to OfferingEnrollment.
model EnrollmentHistory {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   OfferingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  eventType   EnrollmentEventType
  fromStatus  OfferingEnrollmentStatus?
  toStatus    OfferingEnrollmentStatus?
  description String?
  performedBy String?

  createdAt DateTime @default(now())

  @@index([enrollmentId])
}

enum EnrollmentEventType {
  CREATED
  ACTIVATED
  PAUSED
  RESUMED
  COMPLETED
  CANCELLED
  EXPIRED
  EXTENDED
  ACCESS_GRANTED
  ACCESS_REVOKED
  PROGRESS_UPDATED
}

/// The CEO's Access Policy recommendation made concrete as data: an audit
/// trail of *why* access changed, not just a boolean flip on Enrollment.
/// AccessGrantReason already carries reason codes for non-payment access
/// models (SUBSCRIPTION_ENDED etc.) that don't exist yet - extending
/// access policy later is new reason codes read by the same function
/// (src/features/enrollments/server/access-policy.ts), not new boolean
/// fields scattered across models.
model AccessGrant {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   OfferingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// true = this event granted access, false = this event revoked it.
  granted Boolean
  reason  AccessGrantReason

  grantedById String?
  grantedBy   TeamMember? @relation(fields: [grantedById], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())

  @@index([enrollmentId])
}

enum AccessGrantReason {
  PAYMENT_CONFIRMED
  ADMIN_APPROVED
  FREE_OFFERING
  MANUAL_OVERRIDE
  POLICY_VIOLATION
  EXPIRED
  SUBSCRIPTION_ENDED
}

/// Historical record for a future progress chart - Enrollment.progressPercentage/
/// currentModule stay the cheap "current value" columns every card reads;
/// this is the append-only log a future LMS writes into as real lesson
/// completion happens. One snapshot (0%) is written at enrollment creation
/// so the timeline has something real to show, not a fabricated history.
model ProgressSnapshot {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   OfferingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  progressPercentage Int
  currentModule      String?
  recordedAt         DateTime @default(now())

  @@index([enrollmentId])
}

// ============================================
// LEARNING PLATFORM (Phase 9)
// ============================================
//
// The reusable learning domain behind OfferingEnrollment - designed to
// support self-paced programs, live cohorts, corporate training, and
// internships without a future redesign, not "a video course table."
//
// Structure: Module -> Lesson -> LessonBlock. Two grouping levels plus the
// actual content unit - deliberately not the deeper Section/Module/Lesson/
// Learning-Unit nesting a naive reading might suggest; every real LMS
// (Coursera, Teachable, LinkedIn Learning) gets by on two grouping levels,
// and a third would only add query/UI complexity with nothing gained.
//
// LearningExperience is an optional 1:1 extension of Offering - same
// nullable-back-relation pattern already used three times in this file
// (Offering<->OperationItem via Request/Order, Offering<->OfferingEnrollment):
// only some OfferingCategory values (Training, Internship, Corporate
// Training) ever have curriculum.
model LearningExperience {
  id String @id @default(cuid())

  offeringId String   @unique
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  /// Both optional - default to the Offering's own title/description in the
  /// UI when unset, only override here if the curriculum needs different framing.
  title       String?
  description String? @db.Text

  /// Instructor-of-record prep (the brief's "Instructor View" section) -
  /// not a full instructor portal, just who owns this curriculum.
  leadInstructorId String?
  leadInstructor   TeamMember? @relation(fields: [leadInstructorId], references: [id], onDelete: SetNull)

  modules      Module[]
  liveSessions LiveSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Ordered top-level grouping within a LearningExperience.
model Module {
  id String @id @default(cuid())

  learningExperienceId String
  learningExperience   LearningExperience @relation(fields: [learningExperienceId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([learningExperienceId])
}

/// Ordered content unit within a Module - the thing a student actually
/// navigates to and completes.
model Lesson {
  id String @id @default(cuid())

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title   String
  slug    String
  order   Int
  summary String?

  estimatedMinutes Int?
  /// A previewable lesson is visible to a visitor with no enrollment at
  /// all - a real conversion lever (see the Offering detail page's future
  /// "preview this lesson" hook), not built into the UI this phase.
  isPreviewable    Boolean @default(false)

  /// Simple linear gating, not a prerequisite graph - finish the previous
  /// lesson (by `order`) in this module before this one unlocks. A full
  /// DAG-based prerequisite system is real over-engineering for a first
  /// pass and wasn't asked for ("support future prerequisites *if
  /// appropriate*"). `unlocksAt` is a separate, genuinely different need -
  /// drip-fed content for live cohort programs - cheap to include now.
  requiresPreviousCompletion Boolean   @default(true)
  unlocksAt                  DateTime?

  blocks   LessonBlock[]
  progress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId])
}

enum LessonBlockType {
  RICH_TEXT
  MARKDOWN
  VIDEO
  PDF
  SLIDES
  EXTERNAL_LINK
  EMBED
  CODE
  LIVE_SESSION
  ASSIGNMENT
  PROJECT
  QUIZ
  AI_CONVERSATION
  DOWNLOAD
}

/// The polymorphic content unit within a Lesson - the decision that makes
/// "content types added without redesign" real. Simple, display-only types
/// (rich text, markdown, video, PDF, slides, external link, embed, code)
/// use `content: Json`, validated per type by
/// src/features/learning/lib/block-types.ts, not the database. Types that
/// need real structure and tracking - not just display - get a nullable FK
/// to a dedicated model instead of a bigger Json blob: you can attach a
/// reusable Resource, grade an Assessment, or schedule a LiveSession, but
/// you can't do any of those to a Json blob.
model LessonBlock {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  type  LessonBlockType
  order Int
  title String?

  content Json?

  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  liveSessionId String?
  liveSession   LiveSession? @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
}

enum ResourceType {
  PDF
  SLIDES
  DOWNLOAD
  LINK
  VIDEO_FILE
  DOCUMENT
}

/// A reusable learning asset - attach the same Resource to many
/// LessonBlocks across many lessons/courses without ever duplicating the
/// file or its metadata (the brief's explicit requirement).
model Resource {
  id String @id @default(cuid())

  title    String
  type     ResourceType
  url      String
  fileSize Int?
  mimeType String?

  createdById String?
  createdBy   TeamMember? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  blocks LessonBlock[]

  createdAt DateTime @default(now())
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  PROJECT
  SURVEY
}

/// One reusable "gradeable unit" model covers Quizzes, Assignments, *and*
/// Projects - not three separate systems. Structurally they're the same
/// shape (a definition + a student's attempt at it); `type` and the
/// flexible `config` Json (quiz questions / assignment rubric / project
/// brief - shape per type, validated in code) are what actually differ.
model Assessment {
  id String @id @default(cuid())

  title        String
  type         AssessmentType
  instructions String?        @db.Text
  config       Json?
  passingScore Int?

  blocks      LessonBlock[]
  submissions AssessmentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  /// Phase 10 - a mentor asked for changes; the student resubmitting flows
  /// back to SUBMITTED via the existing submitAssessment() action, no new
  /// transition code needed.
  REVISION_REQUESTED
  GRADED
}

/// A student's attempt at an Assessment - `answers` for a QUIZ (scored by
/// comparing against `Assessment.config`'s answer key, a grading function
/// not a UI this phase), `content`/`fileUrl` for an ASSIGNMENT/PROJECT
/// deliverable. `reviewedById` prepares the future mentor-review workflow
/// (the brief's explicit "do not necessarily implement review workflows
/// yet") without inventing a second submission system to bolt it onto later.
model AssessmentSubmission {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   OfferingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  status SubmissionStatus @default(NOT_STARTED)

  answers Json?
  content String? @db.Text
  fileUrl String?

  score    Int?
  feedback String? @db.Text

  reviewedById String?
  reviewedBy   TeamMember? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  /// Phase 10 - a mentor-reviewed submission, parallel to reviewedBy/
  /// reviewedById above (mutually-exclusive-in-practice nullable FKs,
  /// enforced in gradeSubmission()'s code, not a DB constraint - same
  /// pattern as every other either/or FK pair in this schema). Added
  /// instead of repointing reviewedById at Mentor so the existing
  /// admin-review path keeps working unchanged.
  reviewedByMentorId String?
  reviewedByMentor   Mentor? @relation("MentorReviewer", fields: [reviewedByMentorId], references: [id], onDelete: SetNull)

  submittedAt DateTime?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, enrollmentId])
  @@index([enrollmentId])
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// The real progression engine - one row per student per lesson. Every
/// "Continue learning", "resume progress", "mark complete", and unlock
/// decision reads from this table, not from OfferingEnrollment's
/// denormalized fields (those are written *from* this table - see
/// recalculateEnrollmentProgress() in src/features/learning/server/progression.ts).
/// `timeSpentSeconds`/timestamps are also the analytics-readiness data the
/// brief asks for (completion, drop-off, velocity) - queries over this
/// table, not a separate analytics table with no writer yet.
model LessonProgress {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   OfferingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  status LessonProgressStatus @default(NOT_STARTED)

  startedAt   DateTime?
  completedAt DateTime?

  /// Video resume position - "resume progress" for any block type with a natural playhead.
  lastPositionSeconds Int?
  timeSpentSeconds    Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

/// Phase 10 - what kind of session this is. LIVE_CLASS is the Phase 9
/// original meaning (curriculum-bound, TeamMember-hosted); the other three
/// are mentor-led and not necessarily tied to any LearningExperience.
enum LiveSessionType {
  LIVE_CLASS
  ONE_ON_ONE
  OFFICE_HOURS
  GROUP_MENTORING
}

/// Descriptive only - no SDK integration, no calendar sync. Satisfies
/// "prepare integrations with providers... without tightly coupling the
/// architecture" without adding a dependency this codebase doesn't need yet.
enum LiveSessionProvider {
  GOOGLE_MEET
  ZOOM
  OTHER
}

/// A real, lightweight scheduling record - mirrors Meeting's simplicity
/// (Phase 7's Operations Engine) exactly. No calendar sync, no video
/// integration; just the data a "Live Classes"/"Office Hours" surface
/// needs to exist.
///
/// Phase 10 generalizes this from "curriculum live class only" to the one
/// scheduling model for mentor-led sessions too (1:1, office hours, group
/// mentoring) - the brief explicitly asks to extend this existing
/// preparation rather than build a parallel MentorSession table.
/// learningExperienceId went from required to optional for exactly that
/// reason; every pre-Phase-10 row keeps sessionType's default of
/// LIVE_CLASS, so no existing behavior changes.
model LiveSession {
  id String @id @default(cuid())

  learningExperienceId String?
  learningExperience   LearningExperience? @relation(fields: [learningExperienceId], references: [id], onDelete: Cascade)

  sessionType LiveSessionType      @default(LIVE_CLASS)
  provider    LiveSessionProvider?

  title           String
  scheduledAt     DateTime
  durationMinutes Int?
  meetingUrl      String?

  /// TeamMember-hosted curriculum classes - unchanged from Phase 9.
  hostId   String?
  host     TeamMember? @relation(fields: [hostId], references: [id], onDelete: SetNull)
  /// Mentor-led sessions - new in Phase 10, parallel to hostId above
  /// (mutually-exclusive-in-practice, enforced in code).
  mentorId String?
  mentor   Mentor?     @relation(fields: [mentorId], references: [id], onDelete: SetNull)

  status LiveSessionStatus @default(SCHEDULED)

  blocks    LessonBlock[]
  /// Per-student booking/attendance - curriculum LIVE_CLASS sessions never
  /// needed this (broadcast, not booked); mentor-led sessions do.
  attendees MentorSessionAttendee[]

  createdAt DateTime @default(now())
}

enum CertificateStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  ISSUED
}

/// Eligibility/issuance record only - no PDF generation, no template. The
/// concrete row src/features/enrollments/server/access-policy.ts's
/// `canViewCertificates` (Phase 8) will eventually check against, and the
/// future certificate-generation phase writes into.
model Certificate {
  id String @id @default(cuid())

  enrollmentId String             @unique
  enrollment   OfferingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// Backs a future human-friendly certificate number, derived not stored - same convention as every other sequence in this schema.
  sequence Int @unique @default(autoincrement())

  status   CertificateStatus @default(NOT_ELIGIBLE)
  issuedAt DateTime?

  createdAt DateTime @default(now())
}

// ============================================
// MENTOR & LEARNING DELIVERY (Phase 10)
// ============================================
//
// The human side of learning - Student -> Learning -> Mentor -> Assignments
// -> Feedback -> Growth. Mentor is a dedicated model, not TeamMember: staff
// (TeamMember) are internal-only by definition, but mentors include
// external people (industry experts, corporate mentors) who must never be
// CRM/staff users. Mentor is 1:1 with User (role MENTOR), the exact same
// shape TeamMember already uses for staff identity - just for a different
// population.

/// Purely descriptive/filterable - drives zero different code paths, same
/// spirit as LessonBlockType's many values. Adding a new mentor type later
/// is one enum value, not a redesign.
enum MentorType {
  INTERNAL
  EXTERNAL
  INDUSTRY_EXPERT
  CORPORATE
  INTERNSHIP_SUPERVISOR
}

model Mentor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type MentorType

  /// Internal mentors who are also staff (e.g. a COUNSELLOR who mentors) -
  /// optional, not required; most external/industry/corporate mentors
  /// leave this null.
  affiliatedTeamMemberId String?     @unique
  affiliatedTeamMember   TeamMember? @relation(fields: [affiliatedTeamMemberId], references: [id], onDelete: SetNull)

  headline String?
  bio      String? @db.Text

  /// Flat string lists - native Postgres arrays, not Json. The Json+Zod
  /// pattern elsewhere in this schema (Offering.faqs, LessonBlock.content)
  /// is for structured/heterogeneous data; a flat tag list doesn't need it.
  expertiseAreas String[]
  languages      String[]

  experienceYears Int?
  profilePhotoUrl String?
  /// { linkedin?, twitter?, website?, github? } - Zod-validated in
  /// src/features/mentors/validation.
  socialLinks     Json?
  /// { timezone, weeklySlots: [{day, startTime, endTime}] } - descriptive
  /// availability only, no booking-conflict engine.
  availability    Json?

  isActive Boolean @default(true)

  assignments         MentorAssignment[]
  sessions            LiveSession[]
  conversations       MentorConversation[]
  announcements       MentorAnnouncement[]
  reviewedSubmissions AssessmentSubmission[] @relation("MentorReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MentorAssignmentStatus {
  ACTIVE
  PAUSED
  ENDED
}

/// The reusable Student<->Mentor relationship - the brief's "one mentor /
/// multiple mentors / temporary mentors / program-specific mentors" all
/// fall out of this one model: multiple mentors per student is just
/// multiple rows; program-specific is enrollmentId set (null = platform-
/// wide); temporary is endDate + status ENDED once it lapses.
model MentorAssignment {
  id String @id @default(cuid())

  mentorId  String
  mentor    Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  enrollmentId String?
  enrollment   OfferingEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  status    MentorAssignmentStatus @default(ACTIVE)
  /// Which mentor to lead with in the UI when a student has several -
  /// simpler than a full assignment-role enum for a "which one is primary"
  /// question.
  isPrimary Boolean                @default(true)

  startDate DateTime  @default(now())
  endDate   DateTime?
  notes     String?

  assignedById String?
  assignedBy   TeamMember? @relation(fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([mentorId])
}

enum AttendeeStatus {
  INVITED
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

/// Per-student booking/attendance for a LiveSession - one row for a 1:1,
/// many for group mentoring, optional RSVP tracking for a curriculum live
/// class. Also the raw data for the brief's "session attendance" analytics
/// extension point - no separate analytics table needed.
model MentorSessionAttendee {
  id String @id @default(cuid())

  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  studentId     String
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status AttendeeStatus @default(INVITED)

  createdAt DateTime @default(now())

  @@unique([liveSessionId, studentId])
}

/// One running thread per (mentor, student) pair - not a general DM/channel
/// system. Deliberately not scoped by enrollment (unlike MentorAssignment
/// above, which legitimately needs program-scoping): a student's
/// relationship with a given mentor doesn't need to fork per course, and
/// forcing it to would be exactly the unnecessary complexity the brief
/// warns against.
model MentorConversation {
  id String @id @default(cuid())

  mentorId  String
  mentor    Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime?
  messages      MentorMessage[]

  createdAt DateTime @default(now())

  @@unique([mentorId, studentId])
}

model MentorMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Either participant's User id - a mentor and a student are both Users
  /// regardless of role, so one FK covers both sides of the thread.
  senderId String?
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)

  content String    @db.Text
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
}

/// One-to-many broadcast from a mentor to their currently-assigned
/// students - distinct from MentorMessage's 1:1 conversational shape.
/// Read-tracking lives on Notification (below), not duplicated here -
/// creating an announcement fans out one Notification per assigned student.
model MentorAnnouncement {
  id String @id @default(cuid())

  mentorId String
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  title   String
  content String @db.Text

  createdAt DateTime @default(now())

  @@index([mentorId])
}

/// The reusable notification architecture the brief asks for - one generic
/// model, one writer (createNotification in
/// src/features/notifications/server/creation.ts), called non-fatally by
/// every feature that produces a notification-worthy event. Replaces the
/// dashboard shell's dummy INITIAL_NOTIFICATIONS static data with real rows.
/// SESSION_REMINDER/ASSIGNMENT_DEADLINE are prepared types - nothing
/// schedules them proactively yet since this codebase has no background
/// job runner; that stays a documented future extension, not a stub table.
enum NotificationType {
  MENTOR_ASSIGNED
  SESSION_SCHEDULED
  SESSION_REMINDER
  FEEDBACK_RECEIVED
  ASSIGNMENT_DEADLINE
  MENTOR_ANNOUNCEMENT
  MESSAGE_RECEIVED
  /// An Order transitions to PAID - see notifyOrderPaid() (src/features/orders/server/notify.ts).
  PAYMENT_RECEIVED
  /// A Meeting is scheduled against an OperationItem the customer owns - see
  /// notifyMeetingScheduled() (src/features/operations/server/notify.ts).
  MEETING_SCHEDULED

  // --- Sales CRM ---
  /// A SalesLead is assigned/reassigned to a salesperson.
  SALES_LEAD_ASSIGNED
  /// A SalesFollowUp is due today or overdue - written eagerly on creation
  /// for now (no scheduled/cron reminder job exists in this codebase yet -
  /// same documented "prepared, not proactively scheduled" treatment as
  /// SESSION_REMINDER above).
  FOLLOW_UP_REMINDER
  /// A SalesProject is assigned to a salesperson/developer/project manager.
  SALES_PROJECT_ASSIGNED
  /// A SalesCommission moves PENDING -> APPROVED.
  COMMISSION_APPROVED
  /// A SalesCommission moves APPROVED -> PAID.
  COMMISSION_PAID
  /// A client's custom price proposal on an OfferingRequest is approved -
  /// see approveCustomQuote (src/features/offering-requests/actions/admin-quote-actions.ts).
  QUOTE_APPROVED
  /// A client's custom price proposal on an OfferingRequest is rejected -
  /// see rejectCustomQuote (src/features/offering-requests/actions/admin-quote-actions.ts).
  QUOTE_REJECTED

  // --- AI Lead Intelligence Platform ---
  /// A new AILeadReport crosses the "hot lead" opportunity-score threshold -
  /// see generate-report.ts (src/features/lead-intelligence/server).
  BUSINESS_HIGH_OPPORTUNITY_SCORE
  /// A LeadIntelligenceSearchRun (connector run) ends in status FAILED.
  LEAD_INTELLIGENCE_RUN_FAILED

  // --- AI Proposal Management ---
  /// The client opens a sent Proposal's public link for the first time.
  PROPOSAL_VIEWED
  /// The client leaves a comment or question on a Proposal.
  PROPOSAL_COMMENTED
  /// The client requests a meeting via a Proposal's comment box.
  PROPOSAL_MEETING_REQUESTED
  /// The client requests changes to a Proposal.
  PROPOSAL_REVISION_REQUESTED
  /// The client accepts a Proposal.
  PROPOSAL_ACCEPTED
  /// The client rejects a Proposal.
  PROPOSAL_REJECTED

  // --- Client Workspace ---
  /// A staff member invites a SalesLead's contact to activate a CLIENT
  /// portal account - see inviteClientToPortal().
  CLIENT_ACCOUNT_INVITED
  /// A ClientDocument (contract, invoice, welcome packet, handover,
  /// warranty...) is uploaded against a SalesLead the client owns.
  DOCUMENT_UPLOADED
  /// A SalesProjectPayment's dueDate has arrived/passed and it's still
  /// unpaid - written eagerly on creation like FOLLOW_UP_REMINDER, no cron.
  PROJECT_PAYMENT_DUE
  /// A ProjectUpdate (daily progress) is posted against the client's project.
  PROJECT_UPDATE_POSTED
  /// A ProjectMilestone's status/percentComplete changes.
  MILESTONE_UPDATED

  // --- Sales Negotiation Loop ---
  /// A SalesLeadMeeting is scheduled against a SalesLead the client owns -
  /// deliberately distinct from MEETING_SCHEDULED (Operations/OperationItem
  /// only) - see notifySalesMeetingScheduled().
  SALES_MEETING_SCHEDULED
  /// Fired by the /api/cron/meeting-reminders endpoint ~30 minutes before a
  /// LeadMeeting or SalesLeadMeeting's scheduledAt - goes to the TeamMember
  /// who scheduled it (internal, staff-facing), not the client - the
  /// client-facing "it's scheduled" notice is SALES_MEETING_SCHEDULED above,
  /// fired once at creation time; this is the separate day-of reminder.
  MEETING_REMINDER
  /// A SalesQuote is sent to a SalesLead's linked client account - see
  /// createAndSendQuote() (src/features/sales-crm/actions/quote-actions.ts).
  SALES_QUOTE_SENT
  /// The client accepts/declines a SalesQuote themselves, in-portal - see
  /// respondToQuote() (src/features/client-workspace/actions/quote-actions.ts).
  SALES_QUOTE_RESPONDED

  // --- Lead Capture & Claiming ---
  /// A new Lead is created via submitLead (any source) - fired to every
  /// Role.SALES user - see notifyNewLeadCreated() (src/features/leads/server/notify.ts).
  LEAD_NEW_INBOUND
  /// A Role.SALES rep claims an unclaimed Lead via claimLead - fired to
  /// ADMIN/SUPER_ADMIN for oversight - see notifyLeadClaimed()
  /// (src/features/leads/server/notify.ts).
  LEAD_CLAIMED

  // --- AI Interview Platform ---
  /// An Interview auto-terminates after repeated integrity violations
  /// (tab-switch/fullscreen-exit) - fired to the recruiter who created the
  /// InterviewLink - see logIntegrityViolation()
  /// (src/features/interviews/actions/integrity-actions.ts).
  INTERVIEW_TERMINATED
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?
  /// Where clicking the notification navigates - e.g. /student/mentors/[id]
  /// or /mentor/reviews.
  link  String?

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

// ============================================
// AI INTERVIEW PLATFORM
// ============================================
// A parallel system to the Lead/Operations CRM above, not merged into it -
// same "parallel, not merged" precedent OperationItem already established
// for Lead. Candidates here are job applicants, not Stively's own
// students/clients, and never get a User row - the whole flow is designed
// to run without the candidate ever authenticating (see InterviewLink).

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CLOSED
}

enum InterviewLinkStatus {
  PENDING
  SENT
  OPENED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum InterviewCategory {
  INTRODUCTION
  COMMUNICATION
  BEHAVIOR
  SALES
  PROBLEM_SOLVING
  ROLE_PLAY
  OBJECTION_HANDLING
  COMPANY_AWARENESS
  CAREER_GOALS
  CLOSING
}

enum InterviewStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  HOLD
  REJECT
}

/// A reusable interview "profile" - system prompt, goals, and evaluation
/// rubric for one kind of role (Sales, Frontend Developer, HR...). DB/seed-
/// managed only for now, no admin CRUD UI - same precedent as Testimonial
/// (src/features/notifications aside, this codebase's established pattern
/// for "real content, not user-editable yet" - see prisma seed script).
model InterviewTemplate {
  id                 String   @id @default(cuid())
  name               String   @unique
  /// The persona and behavioral rules the AI interviewer follows - see
  /// PromptService (src/features/interviews/server/prompt-service.ts),
  /// which composes this with live conversation state, never sends it raw.
  systemPrompt       String   @db.Text
  /// What this interview is actually trying to find out - feeds both
  /// question generation and evaluation.
  goals              String[]
  /// Structured per-category rubric, e.g.
  /// { "SALES": "Listens for objection-handling technique...", ... } -
  /// deliberately Json (heterogeneous, not a flat list) per this codebase's
  /// established Json-vs-array convention (see Mentor.expertiseAreas'
  /// comment for the flat-array side of that same convention).
  evaluationCriteria Json

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id          String    @id @default(cuid())
  title       String
  department  String
  description String    @db.Text
  experience  String
  skills      String[]
  /// Minutes - shown to the candidate as "Estimated time" before they start.
  duration    Int       @default(20)
  status      JobStatus @default(DRAFT)

  templateId String
  template   InterviewTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   TeamMember? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  candidates Candidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Candidate {
  id    String  @id @default(cuid())
  name  String
  email String
  phone String?

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  links InterviewLink[]

  createdAt DateTime @default(now())

  /// One active candidacy per job per email - re-inviting the same person
  /// for the same job reuses this row rather than creating a duplicate.
  @@unique([email, jobId])
  @@index([jobId])
}

/// The unauthenticated entry point into an interview - see
/// src/features/interviews/lib/token.ts for generation. Deliberately
/// separate from Interview below (1:1, created lazily) so a link can exist,
/// expire, or be revoked before any interview record is needed.
model InterviewLink {
  id String @id @default(cuid())

  /// crypto.randomBytes(24) base62 - unguessable, never sequential. Never
  /// logged or displayed anywhere except the one-time "here's the link"
  /// admin screen.
  token String @unique

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  status    InterviewLinkStatus @default(PENDING)
  expiresAt DateTime
  /// Set the first time the token resolves successfully - a second
  /// attempt to *start* an interview (not just view the landing page)
  /// after this is set is rejected, per the brief's "cannot be reused".
  usedAt    DateTime?

  interview Interview?

  createdAt DateTime @default(now())

  /// Fixed-window rate limit state for the two public, unauthenticated
  /// candidate actions (startInterview, submitInterviewTurn) - see
  /// src/features/interviews/server/rate-limit.ts. Stored on the DB (not
  /// in-memory) since this app can run across multiple serverless function
  /// instances that don't share process memory.
  rateLimitWindowStart DateTime?
  rateLimitCount       Int       @default(0)

  @@index([token])
  @@index([expiresAt])
}

model Interview {
  id String @id @default(cuid())

  linkId String        @unique
  link   InterviewLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  status          InterviewStatus @default(NOT_STARTED)
  startedAt       DateTime?
  completedAt     DateTime?
  durationSeconds Int?

  /// Which InterviewCategory values have already been covered this
  /// session and in what order - the Interview Engine's own state, read
  /// and appended to on every turn so "never the same sequence twice"
  /// survives a page refresh mid-interview.
  categoriesCovered InterviewCategory[]

  /// Cloudinary secure_url for the candidate's webcam recording, set once
  /// upload finishes (normal completion or termination). Null if recording
  /// was never available - see the "RECORDING_UNAVAILABLE" activity log.
  recordingUrl     String?
  /// Authoritative, server-incremented count of integrity violations
  /// (tab-switch / fullscreen-exit) - see logIntegrityViolation(). Never
  /// trust a client-reported count for this.
  violationCount   Int     @default(0)
  /// Set only when `status` flips to ABANDONED because of an integrity
  /// violation (e.g. "INTEGRITY_VIOLATION"), disambiguating an enforced
  /// termination from any other reason an interview ends up ABANDONED.
  terminatedReason String?

  responses    Response[]
  score        Score?
  activityLogs InterviewActivityLog[]

  createdAt DateTime @default(now())

  @@index([status])
}

/// One row per AI question asked, in order - the real transcript. Not a
/// reference to a static question bank: `question` is the text the model
/// actually generated for this candidate, in this conversation, which is
/// the whole point of a dynamic interview engine rather than a fixed list.
model Response {
  id String @id @default(cuid())

  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  category InterviewCategory
  question String            @db.Text
  answer   String?           @db.Text

  askedAt        DateTime  @default(now())
  answeredAt     DateTime?
  /// Milliseconds between askedAt and answeredAt - one of the "Live
  /// Evaluation" signals (see EvaluationService), and shown to the
  /// recruiter, never the candidate.
  responseTimeMs Int?

  /// Order within the interview - the actual sequence asked, which the
  /// brief requires to never be fixed across interviews.
  sequence Int

  createdAt DateTime @default(now())

  @@index([interviewId, sequence])
}

/// One row per interview - the final structured report. Per-answer signal
/// (see Response) feeds this at interview end; there's no separate
/// per-answer score entity, since the brief is explicit that scores are
/// never shown to the candidate and the recruiter reviews the aggregate,
/// not a running per-question tally.
model Score {
  id          String    @id @default(cuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  overall             Float
  communication       Float
  confidence          Float
  professionalism     Float
  /// Null for non-sales interview templates - not every role's rubric
  /// scores this axis.
  salesSkills         Float?
  problemSolving      Float
  leadershipPotential Float
  learningAbility     Float

  strengths         String[]
  weaknesses        String[]
  suggestedTraining String[]
  recommendation    Recommendation

  /// The full model output this was parsed from - kept for audit and for
  /// re-deriving the structured fields above if the scoring rubric
  /// changes later, without re-running the interview.
  rawEvaluation Json

  createdAt DateTime @default(now())

  @@index([recommendation])
}

/// Named InterviewActivityLog (not ActivityLog) to avoid colliding with
/// the existing Operations-CRM ActivityLog above - same model, different
/// domain, deliberately not merged (see this section's own header comment).
model InterviewActivityLog {
  id String @id @default(cuid())

  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  /// e.g. "LINK_OPENED", "MIC_GRANTED", "MIC_DENIED", "DISCONNECTED",
  /// "GROQ_TIMEOUT", "SPEECH_RECOGNITION_FAILED" - a flat string, not an
  /// enum, since this is an open-ended diagnostic/error log, not a
  /// workflow state machine (contrast Interview.status above).
  type     String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([interviewId])
}

// ============================================
// SALES CRM & COMMISSION MANAGEMENT
// ============================================
// Deliberately its own domain, not an extension of Lead above - Lead is an
// inbound marketing-capture system (contact form submissions, UTM
// attribution, student counselling); this is outbound B2B sales
// prospecting (cold-calling businesses sourced from IndiaMart/Google Maps,
// GST numbers, multi-installment payments, per-salesperson commission) -
// a genuinely different data shape and pipeline. Same "parallel, not
// merged" precedent OperationItem already set against Lead, applied again
// here for the same reason: retrofitting a new concept into a working
// system is exactly the high-risk change that precedent exists to avoid.

enum SalesLeadSource {
  WEBSITE
  WHATSAPP
  LINKEDIN
  COLD_CALLING
  REFERRAL
  INDIAMART
  GOOGLE_MAPS
  FACEBOOK
  INSTAGRAM
  MANUAL
  /// Self-registered and submitted a catalog OfferingRequest, later
  /// bridged into the Sales CRM on quote approval - see
  /// OfferingRequest.promotedSalesLeadId.
  OFFERING_REQUEST
  OTHER
}

enum SalesLeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  INTERESTED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

/// One row per prospective B2B client a salesperson is pursuing. Reuses
/// LeadPriority (LOW/MEDIUM/HIGH) from the Lead domain above - identical
/// shape, no reason to fork it.
model SalesLead {
  id       String @id @default(cuid())
  /// Human-readable reference, e.g. SL-000123 - rendered in lib/labels.ts.
  sequence Int    @unique @default(autoincrement())

  businessName String
  ownerName    String
  industry     String?

  phone    String
  whatsapp String?
  email    String?
  website  String?

  address   String? @db.Text
  city      String?
  state     String?
  country   String  @default("India")
  /// Optional - a cold-called prospect rarely has this on file yet.
  gstNumber String?

  source   SalesLeadSource
  status   SalesLeadStatus @default(NEW)
  priority LeadPriority    @default(MEDIUM)

  /// Quoted/estimated deal size in paise - pipeline-value reporting only,
  /// never what commission is calculated on (see SalesCommission below).
  estimatedValue Int?

  /// Set when status becomes LOST - reuses Lead's LostReason enum above
  /// rather than forking a new one, since most of its values (BUDGET_ISSUE,
  /// COMPETITOR_WON, INTERNAL_TEAM, POSTPONED, CANCELLED, NO_RESPONSE...)
  /// are already genuinely B2B-flavored, not student-specific. Feeds the
  /// "Lost Lead Analysis" report.
  lostReason LostReason?

  assignedToId String?
  assignedTo   TeamMember? @relation("SalesLeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    TeamMember? @relation("SalesLeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Client Workspace - set once the business's contact activates a CLIENT
  /// portal account via inviteClientToPortal(). Deliberately NOT @unique:
  /// one User can be the client on more than one SalesLead over time (a
  /// repeat client's second engagement is a new, separate SalesLead, not a
  /// second project bolted onto the first) - resolveClientProjectViewer
  /// aggregates every SalesLead where clientUserId matches this User.
  clientUserId String?
  clientUser   User?   @relation("SalesLeadClient", fields: [clientUserId], references: [id], onDelete: SetNull)

  /// Self-serve account creation - admin generates this link (or it's
  /// auto-attached to a quote email), the client opens it and sets their own
  /// name/password, no password-reset detour. Same unguessable-token pattern
  /// as Proposal.token/DiscoveryForm.token. Cleared (set to null) once
  /// accepted - one-time use, can't be replayed after the account exists.
  /// See AD-017.
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  inviteSentAt         DateTime?
  inviteOpenedAt       DateTime?
  inviteAcceptedAt     DateTime?

  /// Client Workspace - every document delivered to this business (contract,
  /// invoice, welcome packet, handover, warranty...). See ClientDocument.
  documents ClientDocument[]

  assignments SalesLeadAssignment[]
  activities  SalesLeadActivity[]
  notes       SalesLeadNote[]
  attachments SalesLeadAttachment[]
  followUps   SalesFollowUp[]
  tasks       SalesTask[]
  quotes      SalesQuote[]
  outreach    SalesLeadOutreach[]
  /// Sales Negotiation Loop - pre-sale meetings and the client<->staff
  /// message thread, both visible in the Client Workspace before a project
  /// exists (same tier as documents/quotes).
  meetings    SalesLeadMeeting[]
  messages    SalesLeadMessage[]
  /// A qualified client can have multiple projects over time (repeat/expanded
  /// engagements) - see convertLeadToProject(). Deliberately 1:many, not 1:1:
  /// earlier this was a single SalesProject per lead, but a second real
  /// engagement with an already-won client is a new Project on the SAME
  /// SalesLead/client relationship, not a second unrelated SalesLead.
  projects    SalesProject[]

  /// AI Proposal Management - the discovery readiness checklist and any
  /// proposals generated for this lead. A lead can accumulate more than one
  /// Proposal over its lifetime (e.g. rejected, salesperson later pitches
  /// something materially different) - the UI surfaces the latest
  /// non-expired one as "the active proposal."
  discovery SalesLeadDiscovery?
  proposals Proposal[]

  /// AI Lead Intelligence Platform - set when this SalesLead was created via
  /// promoteToSalesLead() from a discovered Business. The FK actually lives
  /// on Business.promotedSalesLeadId (unique, so a Business can back at most
  /// one SalesLead) - this is just the display-side back-reference.
  sourceBusiness Business? @relation("BusinessPromotedTo")

  /// Set when this SalesLead was created by bridging a self-service
  /// CLIENT OfferingRequest on quote approval - same display-side
  /// back-reference shape as sourceBusiness above, FK lives on
  /// OfferingRequest.promotedSalesLeadId.
  sourceOfferingRequest OfferingRequest? @relation("OfferingRequestPromotedTo")

  /// Set when this SalesLead was created by qualifying a raw inbound Lead
  /// (contact form / /start-project) via qualifyLead() - same display-side
  /// back-reference shape as sourceBusiness/sourceOfferingRequest above, FK
  /// lives on Lead.promotedSalesLeadId.
  sourceLead Lead? @relation("LeadPromotedTo")

  /// Client Discovery & Requirements Form - client-fillable, token-linked,
  /// distinct from the admin-only SalesLeadDiscovery checklist above. See
  /// DiscoveryForm below.
  discoveryForms DiscoveryForm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
  @@index([source])
  @@index([city])
  @@index([clientUserId])
}

/// Append-only ownership log - identical pattern to LeadAssignment above.
/// Every SalesLead always has exactly one active assignment; reassigning
/// marks the current one inactive and creates a new one.
model SalesLeadAssignment {
  id String @id @default(cuid())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  assigneeId String
  assignee   TeamMember @relation("SalesAssignmentOwner", fields: [assigneeId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy   TeamMember? @relation("SalesAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  reason   ReassignmentReason @default(INITIAL)
  isActive Boolean            @default(true)

  createdAt DateTime @default(now())

  @@index([salesLeadId])
}

enum SalesLeadActivityType {
  LEAD_CREATED
  LEAD_ASSIGNED
  LEAD_REASSIGNED
  CALL_LOGGED
  WHATSAPP_LOGGED
  EMAIL_LOGGED
  STATUS_CHANGED
  NOTE_ADDED
  ATTACHMENT_ADDED
  FOLLOW_UP_SCHEDULED
  MEETING_SCHEDULED
  PROPOSAL_UPLOADED
  PROJECT_CREATED
  PAYMENT_RECEIVED
  COMMISSION_GENERATED
  QUOTE_SENT
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  OUTREACH_GENERATED
  PROPOSAL_GENERATED
  PROPOSAL_SENT
  PROPOSAL_VIEWED
  PROPOSAL_COMMENTED
  PROPOSAL_REVISION_REQUESTED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PROPOSAL_MEETING_REQUESTED
  PROPOSAL_MEETING_CONFIRMED

  // --- Client Workspace ---
  CLIENT_ACCOUNT_INVITED
  CLIENT_ACCOUNT_ACTIVATED
  CLIENT_DOCUMENT_UPLOADED
  PROJECT_UPDATE_POSTED
  MILESTONE_UPDATED
}

/// Every meaningful action on a SalesLead gets an activity row - the
/// module's own equivalent of LeadHistory/ActivityLog, kept scoped to this
/// domain rather than reusing either (see this section's header comment).
model SalesLeadActivity {
  id String @id @default(cuid())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  type        SalesLeadActivityType
  description String?
  metadata    Json?

  performedById String?
  performedBy   TeamMember? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([salesLeadId])
}

/// One AI-generated outreach pack per generation run - kept as history (not
/// upserted in place), same "one row per run" convention as
/// BusinessWebsiteAnalysis/AILeadReport in the Lead Intelligence platform.
/// Regenerating creates a new row; the UI shows the latest.
model SalesLeadOutreach {
  id          String    @id @default(cuid())
  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  whatsappMessage String  @db.Text
  emailSubject    String
  emailBody       String  @db.Text
  coldCallScript  String  @db.Text
  /// Null when there's no real named contact to address (e.g. ownerName is
  /// "Unknown") - never a generic "Hi there" LinkedIn request standing in
  /// for a real one.
  linkedinMessage String? @db.Text

  modelUsed String

  generatedById String?
  generatedBy   TeamMember? @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([salesLeadId])
}

// ============================================
// AI PROPOSAL MANAGEMENT
// ============================================
// Not a PDF generator - a real hosted proposal page at a unique unguessable
// URL (same token pattern as InterviewLink), AI-personalized from real
// discovery data, that the client can view/comment/accept without ever
// logging in. See SalesLeadDiscovery below for the readiness gate: a
// proposal should never be generated before discovery is captured.

/// The proposal readiness checklist - a mutable working draft the
/// salesperson fills in until it's ready (same 1:1, edit-in-place shape as
/// SalesProfile), not an append-only event log. "Ready for proposal" is
/// computed in the query layer from these fields, never stored as a
/// separate boolean.
model SalesLeadDiscovery {
  id          String    @id @default(cuid())
  salesLeadId String    @unique
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  budgetDiscussed Boolean @default(false)
  /// Paise.
  budgetMin       Int?
  /// Paise.
  budgetMax       Int?
  budgetNotes     String? @db.Text

  timelineDiscussed   Boolean @default(false)
  timelineExpectation String?

  decisionMakerIdentified Boolean @default(false)
  decisionMakerName       String?
  decisionMakerRole       String?

  requirementsCaptured Boolean @default(false)
  requirementsNotes    String? @db.Text
  /// Salesperson-observed problems - distinct from AI-detected website
  /// issues (BusinessWebsiteAnalysis), never invented, merged with those in
  /// the proposal's "Problems Found" section when both exist.
  painPoints           String? @db.Text

  /// Offering.id[] the salesperson picked - grounds "Proposed Solution".
  selectedOfferingIds String[]
  /// Add-on asks not in the Offering catalog.
  customServiceNotes  String?  @db.Text

  updatedById String?
  updatedBy   TeamMember? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DiscoveryFormStatus {
  DRAFT
  SENT
  OPENED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  /// Lazily flipped from SENT/OPENED on read once expiresAt has passed - same
  /// "write on read, never regress a later status" pattern as Proposal's own
  /// EXPIRED handling (resolveProposalToken). Resendable: resendDiscoveryForm
  /// issues a fresh token + expiresAt rather than re-mailing the dead one.
  EXPIRED
}

/// Stively's own Client Discovery & Requirements Form - CLIENT-filled, sent
/// as a secure unique link, distinct from SalesLeadDiscovery above (which is
/// the salesperson's own internal readiness checklist, never seen by the
/// client). Fields mirror the real intake document's four sections
/// verbatim, not invented. Token pattern is identical to
/// Proposal.token/generateProposalToken - unguessable, single-lead-scoped,
/// optionally expirable, no login required to fill (the authenticated
/// /client/discovery route is preferred once the client has a portal
/// account - see resolveClientProjectViewer - but the token route always
/// works, matching the brief's "client should not need to create a separate
/// account just to fill the form").
model DiscoveryForm {
  id String @id @default(cuid())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  /// Optional - a discovery form can be sent before any SalesProject exists
  /// (pre-conversion, gathering requirements to help write the proposal) or
  /// scoped to one specific project once a client has more than one.
  salesProjectId String?

  token     String    @unique
  expiresAt DateTime?

  status      DiscoveryFormStatus @default(DRAFT)
  sentAt      DateTime?
  openedAt    DateTime?
  submittedAt DateTime?
  reviewedAt  DateTime?

  // --- Section 1: Client & Business Information ---
  clientCompanyName String?
  contactPerson     String?
  contactEmail      String?
  contactPhone      String?
  businessIndustry  String?
  currentWebsite    String?
  businessStage     String?
  primaryGoal       String? @db.Text

  // --- Section 2: Project Requirements ---
  projectDescription   String? @db.Text
  problemToSolve       String? @db.Text
  targetUsers          String? @db.Text
  importantFeatures    String? @db.Text
  hasExistingSystem    Boolean @default(false)
  existingSystemIssues String? @db.Text
  successDefinition    String? @db.Text

  // --- Section 3: Functional Requirements ---
  needsUserAccounts      Boolean @default(false)
  needsAdminDashboard    Boolean @default(false)
  needsPayments          Boolean @default(false)
  needsNotifications     Boolean @default(false)
  needsEmail             Boolean @default(false)
  needsSearch            Boolean @default(false)
  needsBooking           Boolean @default(false)
  needsContentManagement Boolean @default(false)
  needsAnalytics         Boolean @default(false)
  needsIntegrations      Boolean @default(false)
  needsAiFeatures        Boolean @default(false)
  needsMobileResponsive  Boolean @default(false)
  otherFunctionalNeeds   String? @db.Text
  additionalNotes        String? @db.Text

  // --- Section 4: Commercial & Delivery ---
  desiredLaunchDate    DateTime?
  priorityLevel        LeadPriority?
  expectedBudgetRange  String?
  hostingPreference    String?
  maintenanceRequired  Boolean       @default(false)
  postLaunchSupport    String?
  importantConstraints String?       @db.Text
  commercialNotes      String?       @db.Text

  sentById String?
  sentBy   TeamMember? @relation("DiscoveryFormSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedBy   TeamMember? @relation("DiscoveryFormReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesLeadId])
  @@index([status])
}

enum OnboardingFormStatus {
  DRAFT
  SENT
  OPENED
  SUBMITTED
  REVIEWED
  /// Same lazily-persisted expiry pattern as DiscoveryFormStatus.EXPIRED
  /// (see AD-016) - learned from that build that a dedicated IN_PROGRESS
  /// value never actually gets set anywhere without real autosave, so it's
  /// not repeated here.
  EXPIRED
}

/// Stively's own post-approval project kickoff form - built from a real
/// Claude Design handoff (see AD-018), fields transcribed verbatim from
/// that design, not invented. Distinct from DiscoveryForm (AD-016): that one
/// gathers pre-sale requirements and is lead-scoped; this one kicks off one
/// specific already-WON engagement (brand assets, technical access,
/// content, start date) and is project-scoped - a client with two projects
/// needs two separate onboarding forms, one per project. Same
/// token/status/notify architecture as DiscoveryForm throughout.
model OnboardingForm {
  id String @id @default(cuid())

  salesProjectId String
  salesProject   SalesProject @relation(fields: [salesProjectId], references: [id], onDelete: Cascade)

  token     String    @unique
  expiresAt DateTime?

  status      OnboardingFormStatus @default(DRAFT)
  sentAt      DateTime?
  openedAt    DateTime?
  submittedAt DateTime?
  reviewedAt  DateTime?

  // --- Header ---
  formDate   DateTime?
  preparedBy String?

  // --- Section 1: Client Information ---
  company        String?
  primaryContact String?
  email          String?
  phone          String?
  billingInfo    String? @db.Text

  // --- Section 2: Project Information ---
  projectName      String?
  targetAudience   String?
  approvedScope    String? @db.Text
  primaryObjective String? @db.Text

  // --- Section 3: Brand Assets (text fields only - files are OnboardingFormUpload rows) ---
  brandColors String?
  brandFonts  String?

  // --- Section 4: Technical Access ---
  domainRegistrar      String?
  hostingProvider      String?
  githubOrg            String?
  cloudInfrastructure  String?
  apiCredentialsNeeded String?
  thirdPartyServices   String?

  // --- Section 5: Content (text fields only - files are OnboardingFormUpload rows) ---
  productInformation String? @db.Text
  legalPages         String? @db.Text

  // --- Section 6: Communication ---
  primaryCommunicationChannel String?
  primaryDecisionMaker        String?
  reviewApprovalContact       String?

  // --- Section 7: Project Approval ---
  projectStartDate       DateTime?
  expectedMilestoneDates String?
  notes                  String?   @db.Text
  /// The design's confirmation checkbox ("I confirm the information above
  /// is accurate... and I am authorized to submit it").
  confirmedAccurate      Boolean   @default(false)

  uploads OnboardingFormUpload[]

  sentById String?
  sentBy   TeamMember? @relation("OnboardingFormSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedBy   TeamMember? @relation("OnboardingFormReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesProjectId])
  @@index([status])
}

/// One of the design's 7 upload fields (logo, brand guidelines, brand
/// images, existing design files, website copy, content images, documents).
/// A single relational model discriminated by `field`, not 7 separate
/// URL/array columns on OnboardingForm - handles the design's mixed
/// single-file/multi-file fields uniformly (a single-file field just never
/// has more than one row), and mirrors SalesLeadAttachment's existing shape
/// rather than inventing a JSON-blob convention.
enum OnboardingUploadField {
  LOGO
  BRAND_GUIDELINES
  BRAND_IMAGE
  DESIGN_FILE
  WEBSITE_COPY
  CONTENT_IMAGE
  DOCUMENT
}

model OnboardingFormUpload {
  id String @id @default(cuid())

  onboardingFormId String
  onboardingForm   OnboardingForm @relation(fields: [onboardingFormId], references: [id], onDelete: Cascade)

  field    OnboardingUploadField
  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  createdAt DateTime @default(now())

  @@index([onboardingFormId])
}

enum ProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  SENT
  VIEWED
  COMMENTED
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
}

/// The durable proposal identity - one row per proposal "workspace", never
/// deleted, its content lives in ProposalVersion snapshots. status +
/// respondedAt + clientResponseNote directly here (no separate approval
/// table), same shape as SalesQuote.status/respondedAt.
model Proposal {
  id       String @id @default(cuid())
  /// Human-readable reference, e.g. PR-000123 - same convention as SalesLead.sequence.
  sequence Int    @unique @default(autoincrement())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  /// crypto.randomBytes(24) base64url - unguessable, identical pattern to InterviewLink.token.
  token String @unique

  title  String
  status ProposalStatus @default(DRAFT)

  /// Convenience pointer - ProposalVersion.versionNumber is the source of truth.
  currentVersionNumber      Int      @default(0)
  /// Key into currentVersion.content.packages[].id - set on Accept.
  selectedPackageId         String?
  /// Keys into currentVersion.content.calculator.items[].id - set on Accept
  /// instead of selectedPackageId when the proposal uses the interactive
  /// calculator (content.calculator non-empty) rather than fixed packages.
  selectedCalculatorItemIds String[] @default([])

  expiresAt          DateTime?
  sentAt             DateTime?
  firstViewedAt      DateTime?
  lastViewedAt       DateTime?
  viewCount          Int       @default(0)
  respondedAt        DateTime?
  clientResponseNote String?   @db.Text

  /// Fixed-window rate-limit state for the public, token-authenticated
  /// client actions (comment/accept/reject/request-changes) - same
  /// DB-stored pattern InterviewLink uses, needed since this app runs
  /// across stateless serverless instances.
  rateLimitWindowStart DateTime?
  rateLimitCount       Int       @default(0)

  createdById String?
  createdBy   TeamMember? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  versions        ProposalVersion[]
  comments        ProposalComment[]
  meetingRequests ProposalMeetingRequest[]
  pageViews       ProposalPageView[]
  sectionViews    ProposalSectionView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesLeadId])
  @@index([status])
}

enum ProposalVersionSource {
  AI_INITIAL
  AI_REGENERATED
  AI_COPILOT_UPDATE
  MANUAL_EDIT
}

/// Immutable snapshot - regenerating (AI or manual edit) always appends a
/// new version and bumps Proposal.currentVersionNumber, never mutates a
/// past one. "History via more rows, not diffing" - same precedent as
/// BusinessWebsiteAnalysis/AILeadReport.
model ProposalVersion {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  versionNumber Int
  source        ProposalVersionSource

  /// The whole structured document for this version: coverTagline,
  /// executiveSummary, businessUnderstanding, problemsFound[],
  /// opportunityScore (nullable - only present when the lead has a real
  /// AILeadReport, never fabricated), proposedSolution[], featureBreakdown[],
  /// timeline stages[], deliverables[], packages[]
  /// ({id,name,priceAmount,whatsIncluded[]} - price always human-entered,
  /// never AI-proposed), paymentSchedule[] (percentages editable, paise
  /// amounts always computed, never AI-produced), roiEstimate (nullable -
  /// omitted entirely unless the salesperson entered real assumptions),
  /// whyStively, faq[]. Zod-enforced, not Prisma-enforced - same convention
  /// as AILeadReport.recommendations/SalesLeadOutreach's content fields.
  content Json

  /// The salesperson's free-text instruction that produced this version -
  /// null except for AI_COPILOT_UPDATE.
  copilotInstruction String? @db.Text
  /// Null for MANUAL_EDIT.
  modelUsed          String?

  createdById String?
  createdBy   TeamMember? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([proposalId, versionNumber])
  @@index([proposalId])
}

enum ProposalCommentType {
  COMMENT
  QUESTION
  MEETING_REQUEST
  AI_CHAT
}

/// A real relation (not JSON) since comments are queried/counted/timelined
/// independently of the proposal content itself.
model ProposalComment {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  type       ProposalCommentType @default(COMMENT)
  content    String              @db.Text
  /// Whatever name the unauthenticated client typed in - not a verified identity.
  clientName String?
  /// The grounded AI answer, only set for type AI_CHAT - the question itself
  /// lives in `content` above, kept as one row per exchange.
  aiAnswer   String?             @db.Text

  createdAt DateTime @default(now())

  @@index([proposalId])
}

enum MeetingRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
}

/// A client-requested meeting time on a proposal, confirmed manually by the
/// salesperson (real meeting link pasted in, not auto-generated - no Google
/// Calendar/Meet API integration exists in this codebase). Deliberately a
/// separate model from Meeting (which is tied to a post-sale OperationItem
/// and can't represent a pre-sale proposal meeting).
model ProposalMeetingRequest {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  preferredAt DateTime
  clientNote  String?  @db.Text
  /// Whatever name the unauthenticated client typed in - not a verified identity.
  clientName  String?

  status MeetingRequestStatus @default(PENDING)

  confirmedAt     DateTime?
  confirmedMethod PreferredContactMethod?
  meetingLink     String?

  confirmedById String?
  confirmedBy   TeamMember? @relation(fields: [confirmedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([proposalId])
}

/// One row per browser session that opens a proposal's public page - real
/// engagement time, not the simple render-counter Proposal.viewCount already
/// is. sessionId is a client-generated crypto.randomUUID() kept in
/// sessionStorage, never a cookie or cross-visit identifier - no PII beyond
/// what's already collected.
model ProposalPageView {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  sessionId     String
  /// Milliseconds the tab was actually visible (Page Visibility API), not wall-clock.
  totalActiveMs Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([proposalId, sessionId])
  @@index([proposalId])
}

/// Per-section active time within one session - same sessionId as
/// ProposalPageView. sectionKey is a fixed vocabulary the public page's
/// section wrappers emit (e.g. "businessAudit", "pricing", "timeline"), not
/// free text.
model ProposalSectionView {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  sessionId  String
  sectionKey String
  activeMs   Int    @default(0)

  @@unique([proposalId, sessionId, sectionKey])
  @@index([proposalId])
}

enum SalesQuoteStatus {
  SENT
  ACCEPTED
  REJECTED
}

/// A formal price quote a salesperson sends a lead's client - the real
/// negotiation record, not just a status label. Optionally anchored to a
/// catalog Offering (snapshotting its list price for an honest "was
/// ₹20,000" comparison), but the actual quotedAmount can be freely
/// negotiated below (or above) that. No client-facing accept/pay portal
/// exists yet - the salesperson calls the client and records their verbal
/// response via markQuoteResponse, same as a real sales rep's CRM habit.
model SalesQuote {
  id String @id @default(cuid())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  offeringId String?
  offering   Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  /// Snapshotted at send time - offering.title if one was picked, otherwise free text.
  title          String
  /// Paise - offering.price at send time, for comparison only. Null if no offering was picked or it has no fixed price.
  standardAmount Int?
  /// Paise - the actual amount being offered to this client, which may differ from standardAmount.
  quotedAmount   Int
  currency       String  @default("INR")
  /// Personalized note included in the email to the client.
  message        String? @db.Text

  status      SalesQuoteStatus @default(SENT)
  sentAt      DateTime         @default(now())
  respondedAt DateTime?

  createdById String?
  createdBy   TeamMember? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([salesLeadId])
}

/// A pre-sale meeting scheduled against a SalesLead - deliberately a
/// separate model from Meeting (tied to a post-sale OperationItem) and
/// ProposalMeetingRequest (tied to the public, unauthenticated proposal
/// page). Admin-initiated only: the client sees/receives it, doesn't
/// propose times themselves. Reuses MeetingStatus/PreferredContactMethod
/// as-is - no domain coupling in either enum.
model SalesLeadMeeting {
  id String @id @default(cuid())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  method      PreferredContactMethod?
  meetingLink String?
  notes       String?                 @db.Text
  status      MeetingStatus           @default(SCHEDULED)

  scheduledById String?
  scheduledBy   TeamMember? @relation(fields: [scheduledById], references: [id], onDelete: SetNull)

  /// Set by the meeting-reminder cron once it's fired the 30-minutes-before
  /// notification for this meeting - the guard against reminding the same
  /// meeting twice across repeated cron runs. Null until then.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([salesLeadId])
  @@index([scheduledAt])
}

/// Pre-conversion meeting scheduling, on a raw Lead rather than a SalesLead -
/// deliberately a separate model rather than making SalesLeadMeeting's FK
/// nullable/polymorphic, since every existing SalesLeadMeeting query/UI
/// assumes salesLeadId is always present. Same shape as SalesLeadMeeting on
/// purpose (mirrors its fields exactly) so the reminder cron can treat both
/// tables near-identically. Used for the first-touch call before any
/// SalesLead/client account exists - the admin schedules it directly against
/// the Lead and shares the link over WhatsApp/phone, no client login needed.
model LeadMeeting {
  id String @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  method      PreferredContactMethod?
  meetingLink String?
  notes       String?                 @db.Text
  status      MeetingStatus           @default(SCHEDULED)

  scheduledById String?
  scheduledBy   TeamMember? @relation(fields: [scheduledById], references: [id], onDelete: SetNull)

  /// Same reminder-sent guard as SalesLeadMeeting.reminderSentAt above.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([scheduledAt])
}

/// 1:1 client<->staff messaging on a SalesLead - flat, no wrapper
/// Conversation table needed since a SalesLead already IS the unique
/// pairing (one clientUserId; staff-side is "whoever has access to this
/// lead", not a second fixed identity), same shape as SalesLeadActivity/
/// SalesLeadNote. No per-message readAt tracking (ambiguous with multiple
/// possible staff readers) - createNotification carries the "unread" signal
/// instead. Never logged to SalesLeadActivity - would flood the timeline.
model SalesLeadMessage {
  id String @id @default(cuid())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)

  content String @db.Text

  /// Null until the OTHER side views the thread - a message the sender
  /// wrote never counts as unread to themselves. Powers the admin "unread
  /// messages" inbox (see AD entry) - set via a plain updateMany when the
  /// admin/staff message panel renders, not a per-message click.
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([salesLeadId])
}

/// Manual, human notes - create-only, no edit/delete, same as LeadNote.
model SalesLeadNote {
  id String @id @default(cuid())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  content  String      @db.Text
  authorId String?
  author   TeamMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([salesLeadId])
}

/// Proposals, documents, GST certificates etc. attached to a lead - stored
/// on Cloudinary (already the app's file-storage provider, see
/// src/lib/cloudinary.ts), only the resulting URL and metadata live here.
model SalesLeadAttachment {
  id String @id @default(cuid())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String
  fileType String?
  fileSize Int?

  uploadedById String?
  uploadedBy   TeamMember? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([salesLeadId])
}

enum SalesFollowUpType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  OTHER
}

enum SalesFollowUpStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

/// A scheduled reminder to re-engage a specific lead - distinct from
/// SalesTask below (general assigned work, not necessarily lead-scoped).
model SalesFollowUp {
  id String @id @default(cuid())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   TeamMember  @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    TeamMember? @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  type   SalesFollowUpType   @default(CALL)
  status SalesFollowUpStatus @default(PENDING)
  dueAt  DateTime
  notes  String?             @db.Text

  completedAt     DateTime?
  /// Set when this row itself is the result of rescheduling an earlier one
  /// - the original due date, kept for a simple audit trail without a full
  /// separate history table.
  rescheduledFrom DateTime?

  createdAt DateTime @default(now())

  @@index([assignedToId, status])
  @@index([dueAt])
}

enum SalesTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

/// General assigned work, optionally tied to a lead - a task can exist on
/// its own ("prepare Q3 pitch deck"), unlike SalesFollowUp which always
/// belongs to one lead.
model SalesTask {
  id String @id @default(cuid())

  title       String
  description String? @db.Text

  salesLeadId String?
  salesLead   SalesLead? @relation(fields: [salesLeadId], references: [id], onDelete: SetNull)

  assignedToId String
  assignedTo   TeamMember  @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   TeamMember? @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  priority LeadPriority    @default(MEDIUM)
  status   SalesTaskStatus @default(TODO)
  dueDate  DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId, status])
}

enum SalesProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

/// Created from convertLeadToProject() the moment a SalesLead's status
/// becomes WON - the delivery-side record of a closed B2B deal. Distinct
/// from OperationItem (which tracks delivery for Offering-side
/// Orders/OfferingRequests) - see this section's header comment for why
/// these two "post-sale work" concepts stay separate rather than merging.
/// One SalesLead can own several SalesProjects (salesLeadId is NOT unique -
/// a repeat/expanded engagement with an already-won client is a new Project
/// on the same client relationship, not a second SalesLead).
model SalesProject {
  id       String @id @default(cuid())
  sequence Int    @unique @default(autoincrement())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Restrict)

  /// Distinguishes this project from any others on the same client, e.g.
  /// "Restaurant Website & Ordering Platform" - required precisely because
  /// a client can now have more than one.
  name     String       @default("Project")
  /// Free text, e.g. "Website", "Mobile App", "E-commerce Platform" - same
  /// "not a rigid enum" treatment as SalesLead.industry.
  type     String?
  /// Reuses LeadPriority (LOW/MEDIUM/HIGH) - identical shape to Lead/SalesLead/SalesTask, no reason to fork it.
  priority LeadPriority @default(MEDIUM)

  /// Snapshotted from SalesLead.businessName at conversion time, editable
  /// afterward independently of the originating lead.
  clientName String

  salesPersonId       String?
  salesPerson         TeamMember? @relation("ProjectSalesPerson", fields: [salesPersonId], references: [id], onDelete: SetNull)
  projectManagerId    String?
  projectManager      TeamMember? @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  assignedDeveloperId String?
  assignedDeveloper   TeamMember? @relation("ProjectDeveloper", fields: [assignedDeveloperId], references: [id], onDelete: SetNull)

  /// Total agreed deal value in paise - what SalesProjectPayment rows are
  /// tracked against; commission is calculated per payment, never on this.
  totalValue Int
  status     SalesProjectStatus @default(ACTIVE)

  startDate     DateTime  @default(now())
  targetEndDate DateTime?
  description   String?   @db.Text

  /// Client Workspace - admin-set (never derived from milestones/tasks, no
  /// such subsystem exists yet), shown on the client's project card.
  progressPercent   Int       @default(0)
  /// Client Workspace - set by admin at delivery; null means no warranty
  /// window has started yet. Shown to the client once set.
  warrantyExpiresAt DateTime?

  payments    SalesProjectPayment[]
  commissions SalesCommission[]

  /// Client Workspace - daily progress posts and the ordered milestone/
  /// timeline list, both admin-managed in this pass (see ProjectUpdate,
  /// ProjectMilestone below).
  updates    ProjectUpdate[]
  milestones ProjectMilestone[]

  /// Post-approval kickoff form - see OnboardingForm below. Project-scoped
  /// (not lead-scoped like DiscoveryForm) because onboarding kicks off one
  /// specific engagement - a client with two projects needs two separate
  /// onboarding forms, one per project.
  onboardingForms OnboardingForm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesLeadId])
  @@index([salesPersonId])
  @@index([status])
}

enum SalesProjectPaymentStatus {
  PENDING
  /// Lazily promoted from PENDING once dueDate has passed and it's still
  /// unpaid, on read - same "flip on read, not on a cron job" pattern
  /// InterviewLink uses for EXPIRED.
  DUE
  PAID
}

/// One row per installment against a SalesProject - a project can have
/// many (e.g. 20k / 30k / 50k). Marking one PAID is the sole trigger for
/// commission generation (see SalesCommission below) - never the project's
/// totalValue or any quoted amount.
model SalesProjectPayment {
  id String @id @default(cuid())

  salesProjectId String
  salesProject   SalesProject @relation(fields: [salesProjectId], references: [id], onDelete: Cascade)

  amount Int
  status SalesProjectPaymentStatus @default(PENDING)

  /// Client-facing label, e.g. "Advance Payment (50%)" / "Final Payment (50%)".
  /// Null falls back to a generic "Payment" in the UI.
  label String?

  dueDate   DateTime?
  paidAt    DateTime?
  /// Free text - "Bank Transfer", "UPI", "Cheque #4521", or "Razorpay" once
  /// set automatically by verifyProjectPayment(). Custom B2B deals can still
  /// be settled outside Razorpay and recorded manually, same as before.
  method    String?
  reference String?

  /// Client Workspace - set only when this installment is paid through the
  /// portal's own Razorpay checkout (verifyProjectPayment), mirroring
  /// Order's razorpayOrderId/PaymentId/Signature trio exactly. Null for
  /// every manually-recorded payment.
  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  razorpaySignature String?

  recordedById String?
  recordedBy   TeamMember? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  commission SalesCommission?

  /// Client Workspace - the invoice/receipt PDF(s) admin uploaded against
  /// this specific installment, if any (see ClientDocument.relatedPaymentId).
  documents ClientDocument[]

  createdAt DateTime @default(now())

  @@index([salesProjectId])
  @@index([status])
}

enum SalesCommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

/// Generated automatically the moment a SalesProjectPayment is marked
/// PAID - never hand-created, never calculated from quotation/totalValue.
/// commissionPercentage is a snapshot of the salesperson's SalesProfile
/// rate AT GENERATION TIME, so a later rate change never retroactively
/// alters an already-generated commission.
model SalesCommission {
  id String @id @default(cuid())

  salesPersonId String
  salesPerson   TeamMember @relation("CommissionSalesPerson", fields: [salesPersonId], references: [id], onDelete: Restrict)

  salesProjectId String
  salesProject   SalesProject @relation(fields: [salesProjectId], references: [id], onDelete: Cascade)

  salesProjectPaymentId String              @unique
  salesProjectPayment   SalesProjectPayment @relation(fields: [salesProjectPaymentId], references: [id], onDelete: Cascade)

  /// Snapshot of the triggering payment's amount, in paise.
  paymentAmount        Int
  /// Snapshot, e.g. 10.0 = 10%.
  commissionPercentage Float
  /// paymentAmount * commissionPercentage / 100, rounded to the nearest paisa.
  commissionAmount     Int

  status SalesCommissionStatus @default(PENDING)

  approvedById String?
  approvedBy   TeamMember? @relation("CommissionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  paidAt       DateTime?

  rejectionReason String?

  createdAt DateTime @default(now())

  @@index([salesPersonId, status])
}

// ============================================
// CLIENT WORKSPACE
// ============================================
// Bridges the Sales CRM pipeline to an authenticated CLIENT portal account
// (see SalesLead.clientUserId). Originally documents-only-by-upload; as of
// the documents engine (src/features/documents/), some ClientDocument rows
// are instead deterministically rendered from structured data (invoices,
// receipts, ...) - "generated" never means AI-authored, that distinction
// still holds, it means "the engine composed a PDF from typed input" versus
// "admin uploaded a Canva-designed file." Progress (ProjectUpdate/
// ProjectMilestone) is likewise always admin-posted, not derived from a
// task/Kanban subsystem that doesn't exist yet.

enum ClientDocumentType {
  CONTRACT
  INVOICE
  RECEIPT
  WELCOME_PACKET
  HANDOVER_PACKAGE
  WARRANTY_CERTIFICATE
  OTHER
}

/// Draft/Generated/Sent are meaningful mostly for documents that go through
/// a real review step before delivery (a future NDA/Agreement "send for
/// signature" flow); Invoice/Receipt in this pass skip straight to SENT on
/// creation, since generation IS delivery in the current UX - the engine
/// supports every state, individual document types just don't have to use
/// all of them (see AD-008).
enum DocumentLifecycleStatus {
  DRAFT
  GENERATED
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  ARCHIVED
}

/// One uploaded-or-generated file delivered to a client - the whole "no more
/// email attachments" mechanism. Always anchored to a SalesLead (not
/// SalesProject) since documents like the contract are delivered before a
/// project exists.
model ClientDocument {
  id       String @id @default(cuid())
  sequence Int    @unique @default(autoincrement())

  salesLeadId String
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  type  ClientDocumentType
  title String

  fileUrl  String
  fileSize Int?

  /// Optional - set when this document is the invoice/receipt for one
  /// specific installment, so the client's Payments tab can link straight
  /// to it instead of the client hunting through a flat Documents list.
  relatedPaymentId String?
  relatedPayment   SalesProjectPayment? @relation(fields: [relatedPaymentId], references: [id], onDelete: SetNull)

  uploadedById String?
  uploadedBy   TeamMember? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  /// Documents-engine fields below - null/default for manually uploaded
  /// files, real for anything the documents engine rendered.
  ///
  /// The fine-grained template-registry key (e.g. "INVOICE", "NDA") - a
  /// plain string, not a Prisma enum, deliberately: a new document type
  /// must be addable via the registry alone (src/features/documents/lib/
  /// registry.ts), never a schema migration. Coarser-grained than `type`
  /// above, which only buckets the client-facing UI list.
  templateType String?

  /// Centrally issued by the Document Number Service (never set by a
  /// template) - see DocumentSequence below.
  documentNumber String? @unique

  lifecycleStatus DocumentLifecycleStatus @default(SENT)

  /// Documents are immutable once generated - regenerating creates a new
  /// row (version + 1, supersedesId pointing at the old row) rather than
  /// overwriting fileUrl. The old row's lifecycleStatus flips to ARCHIVED
  /// when it's superseded. Manually uploaded files stay at version 1 with
  /// no chain - re-uploading a Canva file is just a new independent row.
  version Int @default(1)

  supersedesId String?         @unique
  supersedes   ClientDocument? @relation("DocumentVersionChain", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy ClientDocument? @relation("DocumentVersionChain")

  createdAt DateTime @default(now())

  @@index([salesLeadId])
  @@index([relatedPaymentId])
  @@index([templateType])
}

/// Centralized, race-safe document numbering - INV-2026-00001 style.
/// Templates never generate their own number; always go through
/// nextDocumentNumber() (src/features/documents/server/numbering.ts), an
/// atomic increment scoped to (type, year) - the same race-safety pattern
/// claimLead/generateCommissionForPayment already use elsewhere in this
/// codebase. `type` matches ClientDocument.templateType.
model DocumentSequence {
  id   String @id @default(cuid())
  type String
  year Int

  lastNumber Int @default(0)

  @@unique([type, year])
}

/// The "Today / Tomorrow" daily-progress feed on a client's project page -
/// distinct from SalesLeadActivity (an internal CRM audit trail), this is
/// client-facing content the team deliberately writes for the client to read.
model ProjectUpdate {
  id String @id @default(cuid())

  salesProjectId String
  salesProject   SalesProject @relation(fields: [salesProjectId], references: [id], onDelete: Cascade)

  completedItems   String[]
  plannedNextItems String[]
  blockers         String?  @db.Text

  postedById String?
  postedBy   TeamMember? @relation(fields: [postedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([salesProjectId])
}

enum ProjectMilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
}

/// The ordered "Planning -> Design -> Development -> Testing -> Deployment"
/// timeline shown to the client - a simple admin-managed list, not a full
/// Gantt/task-dependency system (out of scope for this pass).
model ProjectMilestone {
  id String @id @default(cuid())

  salesProjectId String
  salesProject   SalesProject @relation(fields: [salesProjectId], references: [id], onDelete: Cascade)

  label           String
  status          ProjectMilestoneStatus @default(PENDING)
  /// Only meaningful while status is IN_PROGRESS - e.g. "Development, 65%".
  percentComplete Int?
  /// Display order - admin-set, not derived from createdAt so milestones
  /// can be reordered without deleting/recreating rows.
  order           Int

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesProjectId, order])
}

/// 1:1 with a TeamMember whose role is SALESPERSON or SALES_MANAGER - the
/// one place a commission rate lives. Admin-editable anytime; never
/// hardcoded anywhere else in the codebase.
model SalesProfile {
  id String @id @default(cuid())

  teamMemberId String     @unique
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  /// Percentage, e.g. 10.0 = 10%. Admin sets/edits this anytime - every
  /// commission generated afterward uses whatever this is at that moment.
  commissionPercentage Float @default(10)
  /// Paise - future-ready quota tracking, not enforced anywhere yet.
  monthlyTarget        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// AI LEAD INTELLIGENCE PLATFORM
// ============================================
// Upstream of the Sales CRM above, deliberately not merged into it - a
// Business is a discovered/unqualified prospect (may never become
// anything); a SalesLead is a prospect a human has decided to actually
// pursue. Same "parallel, not merged" precedent already set between Lead
// and SalesLead elsewhere in this file. Promoting a Business hands it into
// the exact same SalesLead pipeline/RBAC/quoting/commission machinery
// already built above - no second CRM.

enum BusinessDataSource {
  GOOGLE_PLACES
  WEBSITE
  MANUAL_IMPORT
  MANUAL_ENTRY
}

enum BusinessStatus {
  /// Just discovered/imported, nothing done with it yet.
  NEW
  /// Website analysis and/or an AI report has run at least once.
  ANALYZED
  /// Promoted to a SalesLead - see Business.promotedSalesLeadId.
  PROMOTED
  /// Admin explicitly marked not worth pursuing (bad fit, duplicate, closed
  /// business found via website check, etc) - excluded from default views.
  DISMISSED
}

enum WebsiteAnalysisStatus {
  PENDING
  ANALYZING
  COMPLETE
  FAILED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  YOUTUBE
  X
  OTHER
}

enum ConnectorType {
  GOOGLE_PLACES
  WEBSITE
  MANUAL_IMPORT
}

enum ConnectorRunTrigger {
  MANUAL
  CRON
}

enum ConnectorRunStatus {
  RUNNING
  SUCCESS
  /// Completed but with some row/item-level errors (partial success) - same
  /// "report per-row errors, don't fail the whole batch" pattern as
  /// importSalesLeads's rowErrors.
  PARTIAL
  FAILED
}

enum BusinessActivityType {
  BUSINESS_DISCOVERED
  WEBSITE_ANALYZED
  AI_REPORT_GENERATED
  SCORE_RECALCULATED
  DISMISSED
  REACTIVATED
  PROMOTED_TO_SALES_LEAD
  NOTE_ADDED
}

/// One row per prospect surfaced by any connector (Google Places, a scraped
/// website, or a manual CSV import) or entered by hand. Pre-CRM: this is
/// the discovery/qualification stage; promoting to SalesLead below is the
/// deliberate hand-off into the real outbound sales pipeline.
model Business {
  id       String @id @default(cuid())
  sequence Int    @unique @default(autoincrement())

  businessName String
  ownerName    String?
  industry     String?

  phone         String?
  whatsapp      String?
  email         String?
  website       String?
  /// Lowercased, protocol-and-www-stripped (e.g. "acmecorp.com") - the
  /// dedupe key connector runs match new results against, alongside
  /// googlePlaceId. Populated whenever `website` is set.
  websiteDomain String?

  address String? @db.Text
  city    String?
  state   String?
  country String  @default("India")

  dataSource BusinessDataSource
  status     BusinessStatus     @default(NEW)

  /// Google Places' unique place identifier - the second dedupe key,
  /// present only for dataSource GOOGLE_PLACES.
  googlePlaceId     String? @unique
  googleRating      Float?
  googleReviewCount Int?
  /// Raw category/types array Google Places returns, e.g.
  /// ["restaurant","food"] - informs industry inference, not authoritative.
  googlePlaceTypes  Json?

  /// The connector run that first discovered this Business, for
  /// traceability. Null for MANUAL_ENTRY.
  discoveredByRunId String?
  discoveredByRun   LeadIntelligenceSearchRun? @relation("RunDiscoveredBusinesses", fields: [discoveredByRunId], references: [id], onDelete: SetNull)

  /// Set once this Business is promoted - unique so the DB itself
  /// guarantees a Business backs at most one SalesLead. See
  /// promoteToSalesLead (src/features/lead-intelligence/actions/promote-actions.ts).
  promotedSalesLeadId String?     @unique
  promotedSalesLead   SalesLead?  @relation("BusinessPromotedTo", fields: [promotedSalesLeadId], references: [id], onDelete: SetNull)
  promotedAt          DateTime?
  promotedById        String?
  promotedBy          TeamMember? @relation("BusinessPromotedBy", fields: [promotedById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   TeamMember? @relation("BusinessCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  socialProfiles  SocialProfile[]
  websiteAnalyses BusinessWebsiteAnalysis[]
  aiReports       AILeadReport[]
  activities      BusinessActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dataSource])
  @@index([websiteDomain])
  @@index([city])
}

/// Real relation (not Json) - filterable/queryable per platform, and a
/// business can have zero-to-several. Populated exclusively by the website
/// connector/analyzer (Google Places never returns social links).
model SocialProfile {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  url      String

  /// Best-effort, scraped from the page's social links/meta tags where
  /// present (e.g. Open Graph) - null when not determinable without the
  /// platform's own API, which this feature does not call.
  handle String?

  createdAt DateTime @default(now())

  @@unique([businessId, platform, url])
  @@index([businessId])
}

/// One row per website-analysis run for a Business. Kept as history (not
/// upserted in place) so re-analysis after a business improves its site is
/// visible over time - mirrors keeping SalesLeadActivity append-only rather
/// than mutating SalesLead in place.
model BusinessWebsiteAnalysis {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  url    String
  status WebsiteAnalysisStatus @default(PENDING)

  /// 0-100 sub-scores, null until status COMPLETE.
  securityScore    Int?
  seoScore         Int?
  /// A response-time/payload-size proxy - honestly not a real
  /// Lighthouse/Core-Web-Vitals score, which needs a headless browser this
  /// feature deliberately doesn't run.
  performanceScore Int?
  contentScore     Int?
  /// Weighted composite of the four above - the "website score" the
  /// Opportunity Score engine consumes as one input.
  overallScore     Int?

  /// Full structured check output - every individual check's pass/fail/
  /// detail, kept as Json since it's read as a whole report, never
  /// filtered/queried check-by-check across businesses.
  checks Json?

  errorMessage String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([businessId])
  @@index([status])
}

/// One row per AI-generated intelligence pass over a Business - the
/// business-intelligence summary, the Opportunity Score + factor
/// breakdown, and recommendations, all produced together from the same
/// input snapshot so they never drift out of sync with each other.
model AILeadReport {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Plain-language summary of the business and why/why not it's a good
  /// prospect - the Groq-generated narrative.
  summary String @db.Text

  /// 0-100.
  opportunityScore Int
  /// Per-factor contribution, e.g. {"hasWebsite": 12, "websiteQuality": 18,
  /// ...} - always sums to opportunityScore. Shape enforced by Zod in the
  /// scoring engine, not by Prisma.
  scoreFactors     Json
  /// [{title, description, priority: "HIGH"|"MEDIUM"|"LOW", category}] -
  /// folded in here rather than a separate relation since it's a small,
  /// fixed-shape array always read/written as a unit, matching the Json
  /// convention already used elsewhere in this schema.
  recommendations  Json

  /// A ready-to-send opening outreach message for a salesperson - generated
  /// in the same pass so it's grounded in the same summary.
  suggestedOutreachMessage String? @db.Text

  /// Which LeadScoringConfig version produced opportunityScore - so a later
  /// config change doesn't retroactively misattribute an old score.
  scoringConfigId String?
  scoringConfig   LeadScoringConfig? @relation(fields: [scoringConfigId], references: [id], onDelete: SetNull)

  /// e.g. "llama-3.1-8b-instant" - records what actually generated this.
  modelUsed String

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([createdAt])
}

/// Admin-editable scoring weights - the SRS's explicit "not hardcoded"
/// requirement. Never mutated in place; changing weights deactivates the
/// old row and inserts a new one, so historical AILeadReports stay
/// attributable to the config that actually produced them.
model LeadScoringConfig {
  id String @id @default(cuid())

  /// Exactly one row has active=true at a time - enforced in
  /// updateLeadScoringConfig (deactivate old, insert new), not at the DB
  /// level.
  active Boolean @default(true)

  /// All weights are 0-100, expected (Zod-validated, not DB-enforced) to
  /// sum to 100.
  websiteQualityWeight      Int @default(25)
  reviewRatingWeight        Int @default(20)
  reviewCountWeight         Int @default(10)
  hasWebsiteWeight          Int @default(10)
  industryFitWeight         Int @default(15)
  growthSignalsWeight       Int @default(10)
  contactAvailabilityWeight Int @default(10)

  /// Per-industry historical conversion-rate override, e.g.
  /// {"Restaurant": 0.32, "Retail": 0.18} - null means "use the live
  /// computed rate from SalesLead data at score time", populated only when
  /// an admin explicitly applies a Learning Engine suggestion or hand-tunes
  /// a rate.
  industryConversionOverrides Json?

  notes String? @db.Text

  createdById String?
  createdBy   TeamMember? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  reports AILeadReport[]

  @@index([active])
}

/// Audit + observability for every connector invocation - a Google Places
/// search, a single-URL website analysis, or a CSV import - whether
/// triggered by an admin click or Vercel Cron. Doubles as the generic
/// "ConnectorRun" the connector layer writes to (one model, not two - a
/// connector run and a search run are the same event for every connector
/// this feature builds).
model LeadIntelligenceSearchRun {
  id String @id @default(cuid())

  connectorType ConnectorType
  trigger       ConnectorRunTrigger
  status        ConnectorRunStatus  @default(RUNNING)

  /// Connector-specific input, e.g. {"query":"restaurants","location":"Pune, India"}
  /// for GOOGLE_PLACES, {"url":"https://..."} for WEBSITE, {"fileName":"leads.csv"} for MANUAL_IMPORT.
  input Json

  resultCount    Int   @default(0)
  createdCount   Int   @default(0)
  /// Existing Business rows matched instead of duplicated.
  duplicateCount Int   @default(0)
  errorCount     Int   @default(0)
  /// Row/item-level errors, [{item, message}] - same shape discipline as
  /// importSalesLeads's rowErrors.
  errors         Json?

  triggeredById String?
  triggeredBy   TeamMember? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  discoveredBusinesses Business[] @relation("RunDiscoveredBusinesses")

  @@index([connectorType])
  @@index([status])
  @@index([startedAt])
}

/// Append-only event timeline for a Business - exact structural mirror of
/// SalesLeadActivity.
model BusinessActivity {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type        BusinessActivityType
  description String?
  metadata    Json?

  performedById String?
  performedBy   TeamMember? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([businessId])
}

/// Every meaningful admin/system action worth a forensic trail - connector
/// runs, scoring-config changes, business bulk-delete/dismiss. Deliberately
/// generic (actor + action + entity + diff), not a per-feature log, since
/// nothing like this exists anywhere else in the codebase yet and this
/// feature is the first to need one.
model AuditLog {
  id String @id @default(cuid())

  actorId String?
  actor   TeamMember? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// e.g. "lead_intelligence.connector_run", "lead_intelligence.scoring_config_updated".
  action     String
  /// e.g. "Business", "LeadScoringConfig", "LeadIntelligenceSearchRun".
  entityType String
  entityId   String?

  /// Before/after snapshot or a free-form detail payload - shape varies per
  /// action, hence Json; never queried field-by-field, only rendered.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
